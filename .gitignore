node_modules
# Stale test temp dirs — tests must use os.tmpdir(), not package dir
.tmp-*
build
# Cargo build-script modules (`build.rs` includes them by #[path]); source, not output.
!packages/octocode-native/crates/runtime/build/
!packages/octocode-native/crates/runtime-base/build/
dist
**/.octocode-build.lock
.yarn/install-state.gz
_docs
_scripts
campaigns
# DXT files (distribute via GitHub releases)
*.dxt
# npm pack output
*.tgz
# Cloned benchmark repositories are not tracked; their README is.
packages/octocode-benchmark/local/repos/*
!packages/octocode-benchmark/local/repos/README.md
# Package READMEs are authored source and must remain trackable.
!packages/*/README.md

# ─── Rust packages ──────────────────────────────────────────────────────────
# Cargo build artefacts
target/
.octocode-*-target/
# Platform packages track only their manifest and README; binaries and any
# other build output staged there are built per platform, never committed.
packages/*/npm/*/*
!packages/*/npm/*/package.json
!packages/*/npm/*/README.md
# cargo-mutants run output (current and previous run)
mutants.out/
mutants.out.old/
# Benchmark results (local timing data, machine-specific)
**/bench/results/
out
coverage
.vitest/
.octocode
.codex
.env
.cursor
.context
# Bundled skills copied into the octocode CLI package during build/prepack.
/packages/octocode/skills/
# sqlite DB
mcp.sqlite

context
.claude
.pi
AUDIT.md

# Development/benchmark artifacts
autoresearch.*

devScripts
# Stored benchmark data is local; the index, per-question baselines and round scorecards are tracked.
packages/octocode-benchmark/results/*
!packages/octocode-benchmark/results/README.md
!packages/octocode-benchmark/results/baselines/
!packages/octocode-benchmark/results/rounds/
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
output
__pycache__
releases/**
tmp
*.log
homes

# Rust module directories are source, even when named like an ignored artifact
# folder above (`output`, `context`, `tmp`): a module `output.rs` keeps its
# children in `output/`.
!packages/octocode-native/crates/*/src/**/
!packages/octocode-native/crates/*/tests/**/

# Swarm measurement scripts and baselines (2026-11-19); temporary, removed after the fix wave
/skills-dev/octocode-dev/scripts/profile/
