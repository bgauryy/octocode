.tmp-*
build
dist
**/.octocode-build.lock
.yarn/install-state.gz
_docs
_scripts
campaigns
# DXT files (distribute via GitHub releases)
*.dxt
# npm pack output
*.tgz
# octocode-local-testing: the harness, fixtures and validation reports are tracked;
# cloned repos and regenerable or raw run output are not.
octocode-local-testing/repos/*
!octocode-local-testing/repos/README.md
octocode-local-testing/seeded/
octocode-local-testing/bigfiles/
octocode-local-testing/fixtures/large/
octocode-local-testing/fixtures/scratch/
octocode-local-testing/fixtures/rating-*/
octocode-local-testing/results/
octocode-local-testing/.octocode/
octocode-local-testing/validate/*/raw/
octocode-local-testing/validate/*/out/
octocode-local-testing/validate/*/probes/
octocode-local-testing/validate/*/tools/
octocode-local-testing/validate/*/bin/
octocode-local-testing/validate/local/fixtures/
octocode-local-testing/validate/github/runs.jsonl
octocode-local-testing/validate/github/results.json
# Package READMEs are authored source and must remain trackable.
!packages/*/README.md
!packages/*/npm/*/README.md

# ─── Rust / NAPI packages ───────────────────────────────────────────────────
# Cargo build artefacts
target/
.octocode-*-target/
# Compiled NAPI native bindings — built locally per platform, never committed
*.node
# Compiled native CLI binaries in platform packages — built per platform at
# publish time, never committed (mirrors the *.node policy above).
packages/*/npm/*/octocode
packages/*/npm/*/octocode.exe
packages/*/npm/*/octocode-regex-worker
packages/*/npm/*/octocode-regex-worker.exe
# Benchmark results (local timing data, machine-specific)
**/bench/results/
out
coverage
.vitest/
.octocode
.codex
.env
.cursor
.context
# Exception for committed skill bundle
!/skills/octocode-research/output/
# Canonical Agent Skills live here; generated scripts have targeted ignores above.
/skills/octocode-agent-communication/
/skills/octocode-reflection/
# Bundled skills copied into the octocode CLI package during build/prepack.
/packages/octocode/skills/
