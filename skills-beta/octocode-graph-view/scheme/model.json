{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octocode-graph-view/model",
  "title": "Graph view overlay",
  "description": "Semantics the graph cannot derive. Ids are file ids from data.json, or actor:, store:, ext: ids declared in nodes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "description": "3-8 sentences: purpose, main runtime path, layering, where state lives, key risks." }
      }
    },
    "layers": {
      "type": "array",
      "description": "Top (callers) to bottom (stores). Imports from a larger order to a smaller one are derived as upward.",
      "items": {
        "type": "object",
        "required": ["id", "label", "order", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "order": { "type": "number" },
          "match": { "type": "array", "items": { "type": "string" }, "description": "Globs over file ids: * is one segment, ** is any." },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "exempt": { "type": "boolean", "description": "Imports from this layer are never flagged upward (tests, tooling)." }
        }
      }
    },
    "assign": {
      "type": "array",
      "description": "Per-file layer, overriding globs.",
      "items": { "type": "object", "required": ["id", "layer"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "layer": { "type": "string" } } }
    },
    "nodes": {
      "type": "array",
      "description": "Actors, stores and externals the code graph cannot see.",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^(actor|store|ext):" }, "label": { "type": "string" }, "layer": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "edges": {
      "type": "array",
      "description": "Runtime edges imports cannot show.",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "evidence"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "kind": { "enum": ["call", "spawn", "stdio", "ffi", "http", "rpc", "mcp", "db", "event", "config", "file"] },
          "action": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "allowed": {
      "type": "array",
      "description": "Upward imports judged legitimate after a Hypothesis test.",
      "items": { "type": "object", "required": ["source", "target", "reason"], "additionalProperties": false, "properties": { "source": { "type": "string" }, "target": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "action", "evidence"],
              "additionalProperties": false,
              "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "action": { "type": "string" }, "kind": { "type": "string" }, "async": { "type": "boolean" }, "evidence": { "$ref": "#/$defs/evidence" } }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "confidence"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "confidence": { "enum": ["confirmed", "likely", "candidate"] },
          "detail": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "description": "Required when confidence is confirmed." }
        }
      }
    }
  },
  "$defs": {
    "evidence": { "type": "object", "required": ["path", "line"], "additionalProperties": false, "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } } }
  }
}
