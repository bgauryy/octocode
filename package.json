{
  "name": "octocode-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for Octocode MCP and related packages - Model Context Protocol server for advanced GitHub repository analysis and code discovery.",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": "bgauryy/octocode-mcp.git",
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node ./scripts/workspace-health.mjs run build",
    "build:native:all": "yarn workspace octocode-security build:all && yarn workspace @octocodeai/octocode-minifier-utils build:all",
    "build:publish": "yarn build:native:all && yarn workspace octocode-mcp build:publish",
    "docs:verify": "node ./scripts/docs-verify.mjs",
    "health:check": "node ./scripts/workspace-health.mjs check",
    "health:report": "node ./scripts/workspace-health.mjs report",
    "lint": "node ./scripts/workspace-health.mjs run lint",
    "lint:fix": "yarn workspaces foreach -Apt run lint:fix",
    "syncpack:fix": "syncpack fix",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "syncpack:list": "syncpack list",
    "test": "node ./scripts/workspace-health.mjs run test",
    "test:quiet": "yarn workspaces foreach -Apt run test:quiet",
    "typecheck": "node ./scripts/workspace-health.mjs run typecheck",
    "verify": "node ./scripts/workspace-health.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "syncpack": "^14.0.0-alpha.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "resolutions": {
    "axios": "1.13.2",
    "@octocodeai/octocode-minifier-utils-darwin-arm64": "portal:packages/octocode-minifier-utils/npm/darwin-arm64",
    "@octocodeai/octocode-minifier-utils-darwin-x64": "portal:packages/octocode-minifier-utils/npm/darwin-x64",
    "@octocodeai/octocode-minifier-utils-linux-arm64-gnu": "portal:packages/octocode-minifier-utils/npm/linux-arm64-gnu",
    "@octocodeai/octocode-minifier-utils-linux-x64-gnu": "portal:packages/octocode-minifier-utils/npm/linux-x64-gnu",
    "@octocodeai/octocode-minifier-utils-linux-x64-musl": "portal:packages/octocode-minifier-utils/npm/linux-x64-musl",
    "@octocodeai/octocode-minifier-utils-win32-x64-msvc": "portal:packages/octocode-minifier-utils/npm/win32-x64-msvc",
    "octocode-security-darwin-arm64": "portal:packages/octocode-security/npm/darwin-arm64",
    "octocode-security-darwin-x64": "portal:packages/octocode-security/npm/darwin-x64",
    "octocode-security-linux-arm64-gnu": "portal:packages/octocode-security/npm/linux-arm64-gnu",
    "octocode-security-linux-x64-gnu": "portal:packages/octocode-security/npm/linux-x64-gnu",
    "octocode-security-linux-x64-musl": "portal:packages/octocode-security/npm/linux-x64-musl",
    "octocode-security-win32-x64-msvc": "portal:packages/octocode-security/npm/win32-x64-msvc"
  },
  "private": true,
  "workspaces": [
    "skills/*",
    "packages/*"
  ]
}
