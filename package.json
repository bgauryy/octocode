{
  "name": "octocode-monorepo",
  "description": "Monorepo for Octocode MCP and related packages - Model Context Protocol server for advanced GitHub repository analysis and code discovery.",
  "version": "20.2.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "homepage": "https://octocode.ai",
  "license": "MIT",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "repository": "bgauryy/octocode.git",
  "scripts": {
    "contracts:regen": "yarn install && yarn workspace @octocodeai/config generate:tool-contract"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/octocode-native/npm/*",
    "skills/common"
  ],
  "resolutions": {
    "@octocodeai/config": "workspace:*",
    "@octocodeai/octocode-core": "file:../octocode-mcp-host/packages/octocode-core",
    "@octocodeai/octocode-native-darwin-arm64": "workspace:*",
    "@octocodeai/octocode-native-darwin-x64": "workspace:*",
    "@octocodeai/octocode-native-linux-arm64-gnu": "workspace:*",
    "@octocodeai/octocode-native-linux-arm64-musl": "workspace:*",
    "@octocodeai/octocode-native-linux-x64-gnu": "workspace:*",
    "@octocodeai/octocode-native-linux-x64-musl": "workspace:*",
    "@octocodeai/octocode-native-win32-arm64-msvc": "workspace:*",
    "@octocodeai/octocode-native-win32-x64-msvc": "workspace:*"
  }
}
