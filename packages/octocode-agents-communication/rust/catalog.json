        },
        "additionalProperties": false
      },
      "description": "Extend live session presence by 60 seconds. Does not renew path leases.",
      "usage": "heartbeat [json] --session <id> --workspace <path> [--database <file>]"
    },
    {
      "name": "resume",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
