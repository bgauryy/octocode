    {
      "name": "run",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string",
            "enum": [
              "codex",
              "claude",
              "pi"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 86400000
          },
          "trace": {
            "type": "boolean"
          }
        },
        "required": [
          "vendor",
          "model",
          "prompt"
        ],
        "additionalProperties": false
      },
      "description": "Start a managed communication worker using an installed, authenticated Codex, Claude or Pi CLI. Loads this skill, binds nine coordination tools, maintains presence, and delivers messages at idle turns. The proxy acts only on the supplied task and its explicitly authorized response rules; no independent messages or subscriptions. Keep it running while automatic delivery is needed; idle polling uses no model calls. Supply fields as flags (durationMs = --duration-ms). --session resumes an expired identity with fresh vendor history. Use an exact provider/model from pi --list-models for Pi; Pi also needs Node. Own workers stop on termination or duration; this does not attach to arbitrary existing vendor conversations.",
      "usage": "run --vendor codex|claude|pi --model <model> --prompt <task> [--name <name>] [--duration-ms <ms>] [--trace] --workspace <path> [--database <file>] [--session <expired-id>]"
    },
    {
      "name": "skill",
      "description": "Read the bundled companion skill.",
      "usage": "skill"
    },
    {
      "name": "schema",
      "description": "Discover a command with schema <command>, entity names with schema entities, or entity fields with schema entity <name>. Bare schema returns the complete protocol including SQL.",
      "usage": "schema [<command> | entities | entity <name>]"
    },
    {
      "name": "attach",
      "description": "Bind your registered DB identity to an existing recipient. raw uses hooks/CLI and works for any vendor; claude requires a same-user Unix inbox; codex requires its owning app-server loopback WebSocket or Unix socket. Does not create an agent or invoke a model.",
      "usage": "attach [json] --session <id> --workspace <path> [--database <file>]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transport": {
            "enum": [
              "raw",
              "claude",
              "codex"
            ]
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "vendorSession": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "transport"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "dispatch",
      "description": "Deliver one bounded batch from the DB to the attached native session. Codex injection is passive; Claude may wake an idle receiver. Never auto-repeat staged/submitted/uncertain deliveries. Output confirms submission, not handling. Sender model calls: zero.",
      "usage": "dispatch [json] --session <id> --workspace <path> [--database <file>]",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "hook",
      "description": "Return only previously unoffered DB messages for a host to inject; default text is empty when idle. json is for SDK adapters; claude returns UserPromptSubmit additionalContext. Durable staging suppresses repeated history; failures require inspection and explicit retry_delivery. Presence is renewed; ack remains explicit.",
      "usage": "hook [json] --session <id> --workspace <path> [--database <file>]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "text",
              "json",
              "claude"
            ]
          },
          "deferConfirm": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "deferConfirm": {
                  "const": true
                }
              },
              "required": [
                "deferConfirm"
              ]
            },
            "then": {
              "properties": {
                "format": {
                  "const": "json"
                }
              },
              "required": [
                "format"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "listen",
      "description": "Keep the lightweight Rust listener running for an attached session. Native deliveries are submitted from the DB; raw mode maintains presence for hooks/CLI. No sender model, no vendor process spawned. Does not stop the host agent.",
      "usage": "listen --session <id> --workspace <path> [--database <file>] [--duration-ms <ms>]",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "retry_delivery",
      "description": "Explicitly reoffer an unacknowledged, unexpired message after inspecting its prior attempt. A failed/uncertain transport may already have delivered it; this command can cause a duplicate. Recipient only; reason is retained in audit.",
      "usage": "retry_delivery [json] --session <id> --workspace <path> [--database <file>]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "message",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "record_usage",
      "description": "Record available host token telemetry once per key, without conversation text. scope distinguishes per-request from cumulative totals; never sum cumulative snapshots. Missing metrics mean unknown, not zero.",
      "usage": "record_usage [json] --session <id> --workspace <path> [--database <file>]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope": {
            "enum": [
              "request",
              "turn",
              "cumulative"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "cachedInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "key",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "db migrate",
      "description": "Explicitly migrate an intact v1 store to v2 after all sessions have expired or left. Retains identities/messages and adds audit/attachment/dispatch tables. Never repairs unknown schemas.",
      "usage": "db migrate --database <file>",
