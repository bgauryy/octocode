            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "name",
          "vendor"
        ],
        "additionalProperties": false
      },
      "description": "Create a session for any vendor. Use the returned ID as --session; heartbeat every 15 seconds, before its 60-second presence expires.",
      "usage": "join [json] --workspace <path> [--database <file>]"
    },
    {
      "name": "heartbeat",
