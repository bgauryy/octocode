{
  "name": "@octocodeai/octocode-agents-communication",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic CLI for cross-vendor coordination: agent identity, path leases, durable messages, and a companion communication skill.",
  "type": "module",
  "bin": "./skills/octocode-agents-communication/scripts/agents-communication",
  "devDependencies": {
    "@octocodeai/config": "20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-skill.mjs",
    "build:release": "node scripts/build-skill.mjs --release",
    "typecheck": "cargo check --locked",
    "lint": "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && yarn lint:links",
    "lint:links": "node scripts/check-links.mjs",
    "test": "yarn build && cargo test --locked && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:quiet": "yarn build && cargo test --locked --quiet && node --test --test-concurrency=1 --test-reporter=dot tests/*.test.mjs",
    "test:tooling": "node --test --test-concurrency=1 tests/tooling/*.test.mjs",
    "verify": "yarn lint && yarn test && yarn test:tooling",
    "pack:skill": "node scripts/pack-skill.mjs",
    "poc": "yarn build && node scripts/poc.mjs",
    "poc:mesh": "yarn build && node scripts/mesh-poc.mjs",
    "poc:attached": "yarn build && node scripts/attached-poc.mjs",
    "poc:grok-hooks": "yarn build && node scripts/grok-hook-poc.mjs",
    "poc:crash": "yarn build && node scripts/lease-crash-poc.mjs",
    "poc:service-mesh": "yarn build && node scripts/service-mesh.mjs",
    "poc:opencode": "yarn build && node scripts/opencode-poc.mjs",
    "poc:recovery": "yarn build && node scripts/recovery-soak.mjs",
    "poc:acp": "node scripts/acp-probe.mjs",
    "eval:collaboration": "yarn build && node scripts/collaboration-eval.mjs",
    "benchmark:runtime": "yarn build:release && node scripts/runtime-benchmark.mjs",
    "benchmark:scheduling": "yarn build:release && node scripts/scheduling-benchmark.mjs",
    "benchmark:service": "yarn build:release && node scripts/service-benchmark.mjs",
    "benchmark:storage": "yarn build:release && node scripts/storage-benchmark.mjs",
    "benchmark:context": "yarn build:release && node scripts/context-discovery-benchmark.mjs",
    "benchmark:hooks": "node scripts/hook-benchmark.mjs"
  }
}
