{
  "name": "@octocodeai/octocode-agents-communication",
  "version": "0.2.0",
  "license": "MIT",
  "description": "MCP server and /cli operations for durable cross-vendor agent coordination.",
  "type": "module",
  "bin": "./bin/octocode-agents-communication.mjs",
  "devDependencies": {
    "@octocodeai/config": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "octocode-mcp-cli": "workspace:*",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node src/build.ts",
    "clean": "rm -rf dist/ out/",
    "types": "node src/emit-types.ts",
    "typecheck": "yarn run -T tsgo --noEmit -p tsconfig.json",
    "lint": "node src/emit-types.ts --check && yarn run -T oxlint -c ../../.oxlintrc.json .",
    "test": "yarn build && node --test --test-concurrency=4 tests/*.test.ts",
    "test:nightly": "yarn build && node --test tests/nightly/*.test.ts",
    "verify": "yarn lint && yarn typecheck && yarn test && node src/release-smoke.ts",
    "prepack": "yarn build"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "assets",
    "OPERATING.md",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-agents-communication"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./hosts/*": {
      "types": "./dist/hosts/*.d.ts",
      "default": "./dist/hosts/*.js"
    }
  }
}
