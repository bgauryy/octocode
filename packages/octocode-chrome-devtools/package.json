{
  "name": "@octocodeai/octocode-chrome-devtools",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Chrome DevTools MCP server and CLI for browser plans, arbitrary CDP, and complete evidence.",
  "type": "module",
  "bin": "./bin/octocode-chrome-devtools.mjs",
  "exports": {
    ".": "./dist/mcp.js",
    "./cli": "./dist/cli.js",
    "./runtime": "./dist/runtime.js",
    "./skill": "./dist/skills/octocode-chrome-devtools/SKILL.md",
    "./package.json": "./package.json"
  },
  "mcp": {
    "type": "stdio",
    "command": "octocode-chrome-devtools",
    "args": []
  },
  "engines": {
    "node": "^24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@octocodeai/config": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "octocode-mcp-cli": "workspace:*",
    "prettier": "^3.9.10",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "cli": "node bin/octocode-chrome-devtools.mjs /cli",
    "mcp": "node bin/octocode-chrome-devtools.mjs",
    "lint": "prettier --check \"src/**/*.{ts,mts}\" \"tools/**/*.mjs\" \"tests/**/*.mjs\" && node tools/check.mjs && yarn run -T oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "typecheck": "yarn run -T tsgo --noEmit -p tsconfig.json && yarn run -T tsgo --noEmit -p tsconfig.boundaries.json",
    "test": "node tests/hermetic-suite.mjs",
    "test:live": "node tests/live-suite.mjs",
    "test:protocol": "node tests/protocol-suite.mjs",
    "test:mcp": "node tests/protocol-suite.mjs --transport mcp",
    "test:cli": "node tests/protocol-suite.mjs --transport typed-cli",
    "test:webmcp": "node tests/webmcp-tools.check.mjs",
    "test:cdp-all": "node tests/cdp-all-suite.mjs",
    "verify": "yarn build && yarn lint && yarn typecheck && yarn test && yarn test:protocol && yarn test:mcp && yarn test:cli && yarn test:cdp-all && yarn test:webmcp && yarn test:package",
    "prepack": "yarn build",
    "test:package": "node tools/release-smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,mts}\" \"tools/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "OPERATING.md",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-chrome-devtools"
  }
}
