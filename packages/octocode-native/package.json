{
  "name": "@octocodeai/octocode-native",
  "version": "20.0.0",
  "description": "Native Octocode CLI, tool runtime, and engine primitives",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "license": "MIT",
  "type": "module",
  "main": "./js/runtime.cjs",
  "types": "./js/runtime.d.ts",
  "engines": {
    "node": "^24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-native"
  },
  "bin": {
    "octocode": "./bin/octocode.cjs",
    "octocode-regex-worker": "./bin/octocode-regex-worker.cjs"
  },
  "exports": {
    ".": {
      "types": "./js/runtime.d.ts",
      "import": "./js/runtime.js",
      "require": "./js/runtime.cjs"
    },
    "./runtime": {
      "types": "./js/runtime.d.ts",
      "import": "./js/runtime.js",
      "require": "./js/runtime.cjs"
    },
    "./engine": {
      "types": "./js/engine.d.ts",
      "import": "./js/engine.js",
      "require": "./js/engine.cjs"
    },
    "./native.cjs": "./native.cjs",
    "./bin/octocode.cjs": "./bin/octocode.cjs",
    "./bin/octocode-regex-worker.cjs": "./bin/octocode-regex-worker.cjs",
    "./bin/resolve-binary.cjs": "./bin/resolve-binary.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "js",
    "native.cjs",
    "docs/engine",
    "README.md"
  ],
  "napi": {
    "binaryName": "octocode-engine",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "@octocodeai/octocode-native-darwin-arm64": "20.0.0",
    "@octocodeai/octocode-native-darwin-x64": "20.0.0",
    "@octocodeai/octocode-native-linux-arm64-gnu": "20.0.0",
    "@octocodeai/octocode-native-linux-x64-gnu": "20.0.0",
    "@octocodeai/octocode-native-linux-x64-musl": "20.0.0",
    "@octocodeai/octocode-native-win32-x64-msvc": "20.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.3",
    "@types/node": "^24.13.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "yarn audit:rust",
    "audit:rust": "cargo audit -D unmaintained -D unsound -D yanked",
    "build": "node scripts/build-native.cjs --release",
    "build:engine": "node scripts/build-native.cjs --release --only engine",
    "build:engine:dev": "node scripts/build-native.cjs --only engine",
    "build:dev": "node scripts/build-native.cjs",
    "build:all": "yarn clean:binaries && node scripts/build-native.cjs --release --all",
    "build:darwin-arm64": "node scripts/build-native.cjs --release --target darwin-arm64",
    "build:darwin-x64": "node scripts/build-native.cjs --release --target darwin-x64",
    "build:linux-arm64-gnu": "node scripts/build-native.cjs --release --target linux-arm64-gnu",
    "build:linux-x64-gnu": "node scripts/build-native.cjs --release --target linux-x64-gnu",
    "build:linux-x64-musl": "node scripts/build-native.cjs --release --target linux-x64-musl",
    "clean:binaries": "find npm -type f \\( -name 'octocode' -o -name 'octocode.exe' -o -name 'octocode-regex-worker' -o -name 'octocode-regex-worker.exe' -o -name '*.node' \\) -delete && rm -f octocode-native.*.node octocode-engine.*.node",
    "clean:cache": "find target -type d -name incremental -prune -exec rm -rf {} + 2>/dev/null; du -sh target 2>/dev/null || true",
    "clean:cache:sweep": "cargo sweep --maxsize 30 . && yarn clean:cache",
    "deps:rust": "cargo tree --duplicates",
    "test": "yarn test:scripts && vitest run && yarn test:rust",
    "test:node": "vitest run",
    "test:rust": "cargo test --locked -p octocode-native -p octocode-github -p octocode-cli --no-default-features && cargo test --locked -p octocode-engine --all-features && cargo test --locked -p octocode-runtime-napi --features napi-test",
    "test:rust:next": "cargo nextest run --locked -p octocode-native -p octocode-github -p octocode-cli --no-default-features && cargo nextest run --locked -p octocode-engine --all-features && cargo nextest run --locked -p octocode-runtime-napi --features napi-test",
    "lint": "yarn lint:rust",
    "lint:rust": "cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "check:rust": "cargo check --locked --workspace --all-targets --all-features",
    "typecheck": "tsc --noEmit && yarn check:rust",
    "udeps:rust": "cargo +nightly udeps --workspace --all-targets --all-features",
    "machete": "cargo machete --with-metadata",
    "deny": "cargo deny check",
    "timings:rust": "cargo build --workspace --timings",
    "bloat:rust": "cargo bloat --release --crates -p octocode-cli --no-default-features",
    "watch:rust": "cargo watch -x 'check --workspace'",
    "platforms:check": "node scripts/check-platform-binaries.cjs",
    "loader:check": "node scripts/check-engine-loader-entries.cjs",
    "verify:napi-abi": "node scripts/check-engine-napi-abi.cjs",
    "version:check": "node scripts/check-version-consistency.cjs",
    "version:sync": "node scripts/sync-versions.cjs",
    "pack:check": "node scripts/check-pack-size.cjs",
    "docs:claims": "node scripts/check-doc-claims.cjs",
    "verify": "yarn check:crate-boundaries && yarn fmt:rust:check && yarn lint && yarn typecheck && yarn test && yarn deps:rust && yarn loader:check && yarn verify:napi-abi && yarn version:check && yarn workspace @octocodeai/config check:tool-contract && yarn docs:claims",
    "prepublishOnly": "yarn version:check && node ../octocode/scripts/check-no-workspace-protocol.mjs && yarn workspace @octocodeai/config check:core-contract-sync:published",
    "build:win32-x64-msvc": "node scripts/build-native.cjs --release --target win32-x64-msvc",
    "test:scripts": "node tests/platform.test.cjs && node --test tests/build-publication.test.cjs",
    "check:crate-boundaries": "node scripts/check-crate-boundaries.cjs",
    "build:hosts": "node scripts/build-native.cjs --release --only hosts",
    "build:hosts:dev": "node scripts/build-native.cjs --only hosts"
  }
}
