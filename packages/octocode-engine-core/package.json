{
  "name": "@octocodeai/octocode-engine-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Rust engine primitives for Octocode native and N-API consumers",
  "license": "MIT",
  "scripts": {
    "build": "cargo build --release --no-default-features --features portable-default",
    "build:dev": "cargo build --no-default-features --features portable-default",
    "test": "cargo test --lib --tests --no-default-features --features portable-default,embedded-ast-grep-rewrite && cargo build --benches --no-default-features --features portable-default,embedded-ast-grep-rewrite",
    "test:rust": "yarn test",
    "lint": "cargo clippy --all-targets --no-default-features --features portable-default,embedded-ast-grep-rewrite -- -D warnings",
    "lint:rust": "yarn lint",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "check:rust": "cargo check --all-targets --no-default-features --features portable-default,embedded-ast-grep-rewrite",
    "typecheck": "yarn check:rust",
    "verify": "yarn fmt:rust:check && yarn lint && yarn typecheck && yarn test"
  }
}
