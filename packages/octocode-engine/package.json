{
  "name": "@octocodeai/octocode-engine",
  "description": "Compatibility package for @octocodeai/octocode-native/engine",
  "version": "20.0.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "type": "module",
  "dependencies": {
    "@octocodeai/octocode-native": "20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-engine"
  },
  "scripts": {
    "build": "node -e \"console.log('octocode-engine compatibility package: no build required')\"",
    "lint": "node --check index.cjs && node --check index.js",
    "typecheck": "node -e \"console.log('types re-exported from @octocodeai/octocode-native/engine')\"",
    "test": "node -e \"const value=require('@octocodeai/octocode-native/engine');if(typeof value.minifyContent!=='function')process.exit(1)\"",
    "verify": "yarn lint && yarn test",
    "prepublishOnly": "node ../octocode/scripts/check-no-workspace-protocol.mjs"
  }
}
