{
  "name": "@octocodeai/octocode-engine",
  "description": "Rust native Octocode engine for context compression, structural search, and LSP semantic navigation",
  "version": "19.2.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.3",
    "@types/node": "^24.13.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "files": [
    "docs/**",
    "index.cjs",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "main": "index.cjs",
  "napi": {
    "binaryName": "octocode-engine",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "@octocodeai/octocode-engine-darwin-arm64": "19.2.0",
    "@octocodeai/octocode-engine-darwin-x64": "19.2.0",
    "@octocodeai/octocode-engine-linux-arm64-gnu": "19.2.0",
    "@octocodeai/octocode-engine-linux-x64-gnu": "19.2.0",
    "@octocodeai/octocode-engine-linux-x64-musl": "19.2.0",
    "@octocodeai/octocode-engine-win32-x64-msvc": "19.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-engine"
  },
  "scripts": {
    "audit": "yarn audit:rust",
    "audit:rust": "cargo audit -D unmaintained -D unsound -D yanked",
    "binary-size:check": "node scripts/check-binary-size.cjs",
    "build": "napi build --platform --release && node scripts/postbuild.cjs",
    "build:all": "yarn clean:binaries && yarn build:darwin-arm64 && yarn build:darwin-x64 && yarn build:linux-x64-gnu && yarn build:linux-x64-musl && yarn build:linux-arm64-gnu && yarn build:windows-x64",
    "build:darwin-arm64": "napi build --platform --release --target aarch64-apple-darwin && node scripts/postbuild.cjs",
    "build:darwin-x64": "napi build --platform --release --target x86_64-apple-darwin && node scripts/postbuild.cjs",
    "build:dev": "napi build --platform && node scripts/postbuild.cjs",
    "build:linux-arm64-gnu": "napi build --platform --release --cross-compile --target aarch64-unknown-linux-gnu && node scripts/postbuild.cjs",
    "build:linux-x64-gnu": "napi build --platform --release --cross-compile --target x86_64-unknown-linux-gnu && node scripts/postbuild.cjs",
    "build:linux-x64-musl": "napi build --platform --release --cross-compile --target x86_64-unknown-linux-musl && node scripts/postbuild.cjs",
    "build:windows-x64": "napi build --platform --release --cross-compile --target x86_64-pc-windows-msvc && node scripts/postbuild.cjs",
    "check:rust": "cargo check --all-targets --all-features",
    "clean": "rm -rf dist/ && rm -f *.node",
    "clean:binaries": "rm -f *.node && find npm -name '*.node' -delete",
    "deps:dedupe": "node ../../scripts/dedupe-deps.mjs",
    "deps:dedupe:fix": "node ../../scripts/dedupe-deps.mjs --fix",
    "deps:rust": "cargo tree --duplicates",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "lint": "yarn lint:rust",
    "lint:fix": "yarn fmt:rust",
    "lint:rust": "cargo clippy --all-targets --all-features -- -D warnings",
    "loader:check": "node scripts/check-loader-entries.cjs",
    "pack:check": "node scripts/check-pack-size.cjs",
    "platforms:check": "node scripts/check-platform-binaries.cjs",
    "prepublish:verify": "yarn version:check && yarn loader:check && yarn pack:check && yarn platforms:check",
    "prepublishOnly": "yarn version:sync && node ../octocode/scripts/check-no-workspace-protocol.mjs",
    "registry:check": "node scripts/check-registry-consistency.cjs",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:quiet": "yarn test:node",
    "test:rust": "cargo test --lib --tests --all-features && cargo build --benches --all-features",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "udeps:rust": "cargo +nightly udeps --all-targets --all-features",
    "verify": "yarn typecheck && yarn verify:rust && yarn test && yarn pack:check && yarn version:check && yarn loader:check && yarn binary-size:check",
    "verify:napi-abi": "node scripts/check-napi-abi.cjs",
    "verify:rust": "yarn check:rust && yarn fmt:rust:check && yarn lint:rust && yarn test:rust && yarn deps:rust && yarn udeps:rust && yarn audit:rust",
    "version:check": "node scripts/check-version-consistency.cjs",
    "version:sync": "node scripts/sync-versions.cjs"
  },
  "type": "module",
  "types": "index.d.ts"
}
