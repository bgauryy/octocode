{
  "extends": "../../tsconfig.base.json",
  // esbuild bundles src/extension.ts to CommonJS (package.json `build`), so the
  // sources are checked as bundler-resolved ES modules.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
