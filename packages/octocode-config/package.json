{
  "name": "@octocodeai/config",
  "private": true,
  "description": "Octocode unified env + config loader (zero-dep '.' entry) plus the shared tool-contract hub ('./schema', './mcp') and the generated TypeScript/Rust tool input and output types, built from @octocodeai/octocode-core.",
  "version": "20.2.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@octocodeai/octocode-core": "21.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/contracts/schema.d.ts",
      "import": "./dist/contracts/schema.js"
    },
    "./mcp": {
      "types": "./dist/contracts/mcp.d.ts",
      "import": "./dist/contracts/mcp.js"
    }
  },
  "homepage": "https://octocode.ai",
  "keywords": [
    "config",
    "dotenv",
    "env",
    "octocode"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-config"
  },
  "scripts": {
    "build": "node scripts/generate-config-contract.ts && node scripts/generate-tool-contract.ts --check && node build.mjs",
    "check:config-contract": "node scripts/generate-config-contract.ts --check",
    "check:core-contract-sync:published": "node scripts/check-core-contract-sync.cjs",
    "check:tool-contract": "node scripts/generate-tool-contract.ts --check",
    "clean": "rm -rf dist/",
    "generate:config-contract": "node scripts/generate-config-contract.ts",
    "generate:tool-contract": "node scripts/generate-tool-contract.ts",
    "lint": "node scripts/generate-config-contract.ts --check && yarn run -T oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "test": "vitest run --coverage",
    "test:tokens:acceptance": "cd ../.. && node packages/octocode-config/tests/token-precedence.acceptance.mjs",
    "typecheck": "yarn run -T tsgo --noEmit -p tsconfig.json",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
