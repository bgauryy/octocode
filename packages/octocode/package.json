{
  "name": "octocode",
  "description": "Code research CLI for Octocode tools, local workspaces, GitHub repositories, LSP, and MCP setup",
  "version": "20.0.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bin": "./out/octocode.js",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@octocodeai/config": "20.1.0",
    "@octocodeai/octocode-native": "20.0.0"
  },
  "devDependencies": {
    "@octocodeai/octocode-skill-installer": "workspace:*",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "bundledDependencies": [
    "@octocodeai/config"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "files": [
    "out",
    "docs/**",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://octocode.ai",
  "keywords": [
    "ai-coding",
    "claude",
    "claude-code",
    "cli",
    "cline",
    "cursor",
    "github",
    "installer",
    "mcp",
    "model-context-protocol",
    "octocode",
    "windsurf",
    "zed"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode"
  },
  "scripts": {
    "build": "yarn lint && node build.mjs && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs out",
    "build:dev": "node build.mjs",
    "clean": "rm -rf out/",
    "lint": "node ../../node_modules/eslint/bin/eslint.js src tests",
    "lint:fix": "node ../../node_modules/eslint/bin/eslint.js src tests --fix",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "node scripts/check-no-workspace-protocol.mjs",
    "start": "node ./out/octocode.js",
    "test": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "test:quiet": "node ../../node_modules/vitest/vitest.mjs run --reporter=dot --silent",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --watch",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "verify": "yarn lint && yarn typecheck && yarn test"
  },
  "type": "module"
}
