{
  "name": "octocode",
  "description": "Code research CLI for Octocode tools, local workspaces, GitHub repositories, LSP, and MCP setup",
  "version": "19.1.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bin": "./out/octocode.js",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "@octocodeai/config": "19.1.0",
    "@octocodeai/octocode-engine": "19.1.0",
    "@octocodeai/octocode-tools-core": "19.1.0",
    "@octokit/auth-oauth-device": "^8.0.5",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/request": "^10.0.16",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "out",
    "docs/**",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://octocode.ai",
  "keywords": [
    "ai-coding",
    "claude",
    "claude-code",
    "cli",
    "cline",
    "cursor",
    "github",
    "installer",
    "mcp",
    "model-context-protocol",
    "octocode",
    "windsurf",
    "zed"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode"
  },
  "scripts": {
    "build": "yarn readme:sync && yarn lint && node build.mjs && node scripts/bundle-docs.mjs",
    "release": "node ../../scripts/release.mjs --target cli",
    "build:dev": "yarn readme:sync && yarn workspace @octocodeai/octocode-tools-core build:dev && node build.mjs",
    "clean": "rm -rf out/",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "prepack": "yarn readme:sync && node scripts/check-no-workspace-protocol.mjs && node scripts/prepack.mjs",
    "prepublishOnly": "node scripts/check-no-workspace-protocol.mjs",
    "readme:sync": "node ../../scripts/sync-package-readmes.mjs .",
    "start": "node ./out/octocode.js",
    "test": "vitest run --coverage",
    "test:quiet": "vitest run --reporter=dot --silent",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "validate:mcp": "npx tsx scripts/validate-mcp-registry.ts",
    "validate:mcp:json": "npx tsx scripts/validate-mcp-registry.ts --json",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn validate:mcp"
  },
  "type": "module"
}
