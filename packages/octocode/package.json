{
  "name": "octocode",
  "description": "Code research CLI for Octocode tools, local workspaces, GitHub repositories, LSP, and MCP setup",
  "version": "20.2.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bin": "./out/octocode.js",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "optionalDependencies": {
    "@octocodeai/octocode-native-darwin-arm64": "20.2.0",
    "@octocodeai/octocode-native-darwin-x64": "20.2.0",
    "@octocodeai/octocode-native-linux-arm64-gnu": "20.2.0",
    "@octocodeai/octocode-native-linux-arm64-musl": "20.2.0",
    "@octocodeai/octocode-native-linux-x64-gnu": "20.2.0",
    "@octocodeai/octocode-native-linux-x64-musl": "20.2.0",
    "@octocodeai/octocode-native-win32-arm64-msvc": "20.2.0",
    "@octocodeai/octocode-native-win32-x64-msvc": "20.2.0"
  },
  "devDependencies": {
    "@octocodeai/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "out",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://octocode.ai",
  "keywords": [
    "ai-coding",
    "claude",
    "claude-code",
    "cli",
    "cline",
    "cursor",
    "github",
    "installer",
    "mcp",
    "model-context-protocol",
    "octocode",
    "windsurf",
    "zed"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode"
  },
  "scripts": {
    "build": "node build.mjs && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs out",
    "build:dev": "node build.mjs",
    "clean": "rm -rf out/",
    "format": "prettier --write src tests",
    "lint": "prettier --check src tests && yarn run -T oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "prepack": "node scripts/prepack.mjs",
    "start": "node ./out/octocode.js",
    "test": "vitest run --coverage",
    "typecheck": "yarn run -T tsgo --noEmit",
    "verify": "yarn lint && yarn typecheck && yarn test"
  },
  "type": "module"
}
