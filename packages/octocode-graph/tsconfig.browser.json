  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/assets/**/*.ts", "src/browser/**/*.ts", "src/renderer.ts"],
  "exclude": []
}
