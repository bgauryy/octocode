{
  "name": "@octocodeai/octocode-awareness",
  "version": "2.1.0",
  "description": "Octocode Awareness: always-on workspace coordination — awareness, collaboration, learning, memory/wiki, bookkeeping, housekeeping, reflection.",
  "keywords": [
    "octocode",
    "awareness",
    "collaboration",
    "memory",
    "bookkeeping",
    "housekeeping",
    "sqlite",
    "agent"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-awareness"
  },
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "license": "MIT",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/types/src/index.d.ts",
      "import": "./out/index.js",
      "default": "./out/index.js"
    },
    "./bin/awareness": "./out/octocode-awareness.js",
    "./bin/extract-hook-files": "./out/extract-hook-files.js",
    "./schema": "./out/schema-api.js"
  },
  "bin": "./out/octocode-awareness.js",
  "files": [
    "out/**",
    "!docs/**",
    "!skills/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf out/ dist/",
    "lint": "eslint . --config eslint.config.mjs --no-warn-ignored && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn build && vitest run --coverage",
    "test:quiet": "yarn build && vitest run --reporter=dot --silent",
    "test:smoke": "node skills/octocode-awareness/scripts/smoke-multi-agent.mjs",
    "pack:check": "node scripts/verify-package.mjs",
    "prepack": "yarn build && node scripts/verify-package.mjs",
    "self-test": "node out/octocode-awareness.js maintenance self-test",
    "start": "node out/octocode-awareness.js",
    "verify": "yarn lint && yarn test"
  },
  "devDependencies": {
    "@octocodeai/agent-contracts": "0.1.0",
    "@octocodeai/octocode-skill-installer": "0.1.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "isomorphic-git": "^1.42.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "octocode": {
    "readmeSync": false
  },
  "optionalDependencies": {
    "@octocodeai/octocode-extension-rust": "0.1.0"
  }
}
