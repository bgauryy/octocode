{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octocode.ai/schemas/awareness-workspace-policy.v1.schema.json",
  "title": "Octocode Awareness workspace policy",
  "description": "Workspace storage scope and exclusive host lifecycle ownership at .octocode/awareness.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "storage", "hooks"],
  "properties": {
    "version": {
      "const": 1,
      "description": "Workspace policy contract version."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "memory"],
      "properties": {
        "repository": {
          "enum": ["global", "repo"],
          "description": "Storage scope for Context, Work, Message, History, and host events."
        },
        "memory": {
          "enum": ["global", "repo"],
          "description": "Storage scope for Memory."
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "enum": ["guard", "coordination", "full"],
          "description": "Lifecycle breadth for the selected host owner."
        },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": { "$ref": "#/$defs/owner" },
            "codex": { "$ref": "#/$defs/owner" },
            "cursor": { "$ref": "#/$defs/owner" },
            "copilot": { "$ref": "#/$defs/owner" },
            "gemini": { "$ref": "#/$defs/owner" },
            "opencode": { "$ref": "#/$defs/owner" },
            "pi": { "$ref": "#/$defs/owner" }
          }
        }
      }
    }
  },
  "$defs": {
    "owner": {
      "enum": ["shell", "native"],
      "description": "The only lifecycle adapter allowed to process events for this host."
    }
  }
}
