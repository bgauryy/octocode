{
  "name": "octocode-lsp",
  "version": "0.1.0",
  "description": "Reusable LSP client, server registry, and semantic navigation runtime for Octocode",
  "keywords": [
    "code-intelligence",
    "language-server",
    "lsp",
    "octocode",
    "typescript"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-lsp"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./cancellableRequest": {
      "types": "./dist/cancellableRequest.d.ts",
      "import": "./dist/cancellableRequest.js",
      "default": "./dist/cancellableRequest.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "import": "./dist/evidence.js",
      "default": "./dist/evidence.js"
    },
    "./initConstants": {
      "types": "./dist/initConstants.d.ts",
      "import": "./dist/initConstants.js",
      "default": "./dist/initConstants.js"
    },
    "./initParams": {
      "types": "./dist/initParams.d.ts",
      "import": "./dist/initParams.js",
      "default": "./dist/initParams.js"
    },
    "./lspClientPool": {
      "types": "./dist/lspClientPool.d.ts",
      "import": "./dist/lspClientPool.js",
      "default": "./dist/lspClientPool.js"
    },
    "./lspDocumentManager": {
      "types": "./dist/lspDocumentManager.d.ts",
      "import": "./dist/lspDocumentManager.js",
      "default": "./dist/lspDocumentManager.js"
    },
    "./lspErrorCodes": {
      "types": "./dist/lspErrorCodes.d.ts",
      "import": "./dist/lspErrorCodes.js",
      "default": "./dist/lspErrorCodes.js"
    },
    "./lspOperations": {
      "types": "./dist/lspOperations.d.ts",
      "import": "./dist/lspOperations.js",
      "default": "./dist/lspOperations.js"
    },
    "./lspRegistry": {
      "types": "./dist/lspRegistry.d.ts",
      "import": "./dist/lspRegistry.js",
      "default": "./dist/lspRegistry.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js",
      "default": "./dist/manager.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "default": "./dist/resolver.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js",
      "default": "./dist/symbols.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./uri": {
      "types": "./dist/uri.d.ts",
      "import": "./dist/uri.js",
      "default": "./dist/uri.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./workspaceRoot": {
      "types": "./dist/workspaceRoot.d.ts",
      "import": "./dist/workspaceRoot.js",
      "default": "./dist/workspaceRoot.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist/",
    "benchmark": "node benchmark/run.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run --coverage",
    "test:quiet": "vitest run --reporter=dot --silent",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "verify": "yarn typecheck && yarn lint && yarn test"
  },
  "dependencies": {
    "octocode-security": "workspace:^",
    "octocode-shared": "workspace:^",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.18.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260613.1"
  }
}
