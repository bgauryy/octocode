{
  "extends": "./tsconfig.json",
  // Declaration emit for dist/public.d.ts (rolled up by scripts/bundle-dts.mjs).
  // Follow-up: emit with strict on; it is off here until the declaration build
  // is checked under strict.
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}
