{
  "name": "octocode-mcp",
  "description": "Model Context Protocol (MCP) server for code research across GitHub, npm, local files and LSP. A launcher for the native Octocode binary's MCP server.",
  "version": "20.2.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bin": "dist/index.js",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@octocodeai/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "files": [
    "dist/index.js",
    "dist/docs/**",
    "assets/logo.png",
    "manifest.json",
    "server.json",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://octocode.ai",
  "keywords": [
    "ai-tools",
    "anthropic",
    "claude",
    "cli-tool",
    "code-analysis",
    "code-discovery",
    "code-search",
    "codebase-exploration",
    "developer-tools",
    "github",
    "github-api",
    "github-search",
    "mcp",
    "model-context-protocol",
    "nodejs",
    "openai",
    "repository-analysis",
    "semantic-search",
    "typescript"
  ],
  "license": "MIT",
  "mcp": {
    "type": "stdio",
    "command": "octocode-mcp",
    "args": []
  },
  "mcpName": "io.github.bgauryy/octocode-mcp",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-mcp"
  },
  "scripts": {
    "build": "yarn check:manifest && yarn clean && node build.mjs && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs dist",
    "build:dev": "node build.mjs && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs dist",
    "check:manifest": "node scripts/sync-manifest.mjs --check",
    "clean": "rm -rf dist/",
    "format": "prettier --write src tests",
    "lint": "yarn check:manifest && prettier --check src tests && yarn run -T oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "test": "vitest run --coverage",
    "test:acceptance": "yarn test:boundary && cd ../.. && node packages/octocode-benchmark/local/e2e/harness/tool-health.mjs",
    "test:boundary": "cd ../.. && node packages/octocode-benchmark/local/e2e/harness/transport.mjs",
    "test:contracts:classification": "cd ../.. && node packages/octocode-mcp/tests/integration/clasify-availability.acceptance.mjs && node packages/octocode-mcp/tests/integration/selection-execution.acceptance.mjs",
    "typecheck": "yarn run -T tsgo --noEmit -p tsconfig.json",
    "verify": "yarn lint && yarn typecheck && yarn test"
  },
  "type": "module",
  "optionalDependencies": {
    "@octocodeai/octocode-native-darwin-arm64": "20.2.0",
    "@octocodeai/octocode-native-darwin-x64": "20.2.0",
    "@octocodeai/octocode-native-linux-arm64-gnu": "20.2.0",
    "@octocodeai/octocode-native-linux-x64-gnu": "20.2.0",
    "@octocodeai/octocode-native-linux-x64-musl": "20.2.0",
    "@octocodeai/octocode-native-win32-arm64-msvc": "20.2.0",
    "@octocodeai/octocode-native-win32-x64-msvc": "20.2.0"
  }
}
