{
  "name": "octocode-mcp",
  "description": "Model Context Protocol (MCP) server for advanced GitHub repository analysis and code discovery. Provides AI assistants with powerful tools to search, analyze, and understand codebases across GitHub.",
  "version": "20.1.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bin": "dist/index.js",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@octocodeai/octocode-core": "20.0.1",
    "@octocodeai/octocode-native": "20.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octocodeai/config": "workspace:*",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/**/*.d.ts",
    "dist/docs/**",
    "assets/logo.png",
    "manifest.json",
    "server.json",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://octocode.ai",
  "keywords": [
    "ai-tools",
    "anthropic",
    "claude",
    "cli-tool",
    "code-analysis",
    "code-discovery",
    "code-search",
    "codebase-exploration",
    "developer-tools",
    "github",
    "github-api",
    "github-search",
    "mcp",
    "model-context-protocol",
    "nodejs",
    "openai",
    "repository-analysis",
    "semantic-search",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/public.js",
  "mcp": {
    "type": "stdio",
    "command": "octocode-mcp",
    "args": []
  },
  "mcpName": "io.github.bgauryy/octocode-mcp",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-mcp"
  },
  "scripts": {
    "build": "yarn check:manifest && yarn clean && node ../../skills-dev/octocode-dev/scripts/esbuild-package.mjs && yarn build:types && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs dist",
    "build:dev": "OCTOCODE_RUNTIME_PLATFORMS=native node ../../skills-dev/octocode-dev/scripts/esbuild-package.mjs && yarn build:types && node ../../skills-dev/octocode-dev/scripts/package-build.mjs docs dist",
    "build:types": "node ../../node_modules/typescript/bin/tsc --emitDeclarationOnly --outDir dist/.types -p tsconfig.build.json && node scripts/bundle-dts.mjs",
    "build:watch": "node ../../skills-dev/octocode-dev/scripts/esbuild-package.mjs --watch",
    "check:manifest": "node scripts/sync-manifest.mjs --check",
    "clean": "rm -rf dist/",
    "debug": "npx @modelcontextprotocol/inspector node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "lint": "yarn check:manifest && node ../../node_modules/eslint/bin/eslint.js src tests",
    "lint:fix": "node ../../node_modules/eslint/bin/eslint.js src tests --fix",
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "test": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "test:acceptance": "cd ../.. && node packages/octocode-mcp/tests/integration/stdio.acceptance.mjs",
    "test:boundary": "node tests/native/node-boundary.mjs",
    "test:contracts:classification": "cd ../.. && node packages/octocode-mcp/tests/integration/clasify-availability.acceptance.mjs",
    "test:contracts:responses": "node ../../node_modules/vitest/vitest.mjs run tests/tools/all-tools.pagination-contract.test.ts",
    "test:contracts:startup": "node ../../node_modules/vitest/vitest.mjs run tests/index.test.ts tests/public.test.ts",
    "test:quiet": "node ../../node_modules/vitest/vitest.mjs run --reporter=dot --silent",
    "test:ui": "node ../../node_modules/vitest/vitest.mjs --ui",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --watch",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit --skipLibCheck -p tsconfig.package.json",
    "typecheck:full": "node ../../node_modules/typescript/bin/tsc --noEmit --skipLibCheck",
    "verify": "yarn lint && yarn typecheck:full && yarn test"
  },
  "type": "module",
  "types": "dist/public.d.ts"
}
