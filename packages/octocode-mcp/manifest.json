{
  "dxt_version": "0.1",
  "name": "octocode-mcp",
  "display_name": "Octocode MCP Extension",
  "version": "20.2.0",
  "description": "Code research MCP server for GitHub, npm, local files, and LSP semantics",
  "long_description": "MCP server with code research tools across GitHub, npm, local files, and LSP semantics. Agents orient, search, read exact evidence, and prove findings with typed continuations and sanitized output.",
  "author": {
    "name": "Guy Bary",
    "email": "bgauryy@octocodeai.com",
    "url": "https://octocode.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode"
  },
  "homepage": "https://octocode.ai",
  "documentation": "https://github.com/bgauryy/octocode#readme",
  "support": "https://github.com/bgauryy/octocode/issues",
  "icon": "assets/logo.png",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "GITHUB_TOKEN": "${user_config.github_token}"
      }
    }
  },
  "tools": [
    {
      "name": "clasify",
      "description": "Clasify (beta: requires OCTOCODE_BETA and OCTOCODE_CLASSIFICATION_API)"
    },
    {
      "name": "ghSearchRepo",
      "description": "GitHub Repository Search"
    },
    {
      "name": "ghSearchCode",
      "description": "GitHub Code Search"
    },
    {
      "name": "ghStructure",
      "description": "GitHub Structure"
    },
    {
      "name": "ghGetFileContent",
      "description": "GitHub File Content Fetch"
    },
    {
      "name": "ghSearchHistory",
      "description": "GitHub History Search"
    },
    {
      "name": "ghGetHistoryItem",
      "description": "GitHub History Item"
    },
    {
      "name": "artifactSearch",
      "description": "Package Search"
    },
    {
      "name": "localSearch",
      "description": "Local Search"
    },
    {
      "name": "structureSearch",
      "description": "Structure Search"
    },
    {
      "name": "astSearch",
      "description": "AST Search"
    },
    {
      "name": "localFetch",
      "description": "Local Fetch Content"
    },
    {
      "name": "lspSearch",
      "description": "LSP Search"
    }
  ],
  "keywords": [
    "github",
    "npm",
    "code-search",
    "repository",
    "package-manager",
    "development",
    "api",
    "search",
    "mcp",
    "octocode"
  ],
  "license": "MIT",
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": "^24.15.0"
    }
  },
  "user_config": {
    "github_token": {
      "type": "string",
      "title": "GitHub Token",
      "description": "Personal access token for GitHub API (optional, increases rate limits)",
      "sensitive": true,
      "required": false
    }
  }
}
