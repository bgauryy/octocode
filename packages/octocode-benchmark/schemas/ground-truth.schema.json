{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octocode-benchmark/ground-truth",
  "title": "Judge-only compare-suite ground truth",
  "description": "Oracle and scoring contract for one compare suite. Solvers must never read this file. The verifier allows suite-specific extensions but requires enough structure for blind judging and trajectory attribution.",
  "type": "object",
  "required": ["note", "suiteVersion", "questionBankId", "questions"],
  "properties": {
    "note": {
      "type": "string",
      "minLength": 1,
      "description": "Must state that this file is judge-only / hidden from solvers."
    },
    "suiteVersion": { "type": "integer", "minimum": 1 },
    "questionBankId": { "$ref": "#/$defs/stableId" },
    "verificationCaveat": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "harnessRules": {
      "type": "object",
      "additionalProperties": true
    },
    "sharedScoring": {
      "$ref": "#/$defs/scoring",
      "description": "Suite-wide scoring rubric when per-question scoring is intentionally shared."
    },
    "questions": {
      "type": "object",
      "description": "Active questions must be gapless q1..qN; the verifier enforces this data-dependent invariant.",
      "minProperties": 1,
      "maxProperties": 50,
      "patternProperties": {
        "^q(?:[1-9]|[1-4][0-9]|50)$": {
          "$ref": "#/$defs/question"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["verification"],
          "properties": { "verification": true }
        },
        {
          "required": ["verificationCaveat"],
          "properties": { "verificationCaveat": true }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": ["sharedScoring"],
          "properties": { "sharedScoring": true }
        },
        {
          "properties": {
            "questions": {
              "type": "object",
              "patternProperties": {
                "^q(?:[1-9]|[1-4][0-9]|50)$": {
                  "type": "object",
                  "required": ["scoring"],
                  "properties": { "scoring": true }
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 of the canonical frozen question-bank payload."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Branch/tag/PR ref when a 40-hex pin is impractical (mutable oracle); re-verify per run."
        }
      },
      "description": "Repository identity. Pin with commitSha when available; otherwise task.refs plus reverifyBeforeRun define the honest pre-run freeze contract."
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cutoff"],
      "properties": {
        "status": {
          "enum": ["unknown", "control-required", "uncontaminated", "contaminated", "excluded"]
        },
        "cutoff": { "type": "string", "minLength": 1 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxToolCalls", "maxPages", "timeoutMs"],
      "properties": {
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "maxPages": { "type": "integer", "minimum": 0 },
        "maxRunnerTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "scoring": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["full", "partial", "zero"],
          "properties": {
            "full": { "type": "string", "minLength": 1 },
            "partial": { "type": "string", "minLength": 1 },
            "zero": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "oracle": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredClaims", "acceptedVariants"],
          "properties": {
            "requiredClaims": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Atomic decisive claims scored independently."
            },
            "acceptedVariants": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "taskId",
        "difficulty",
        "category",
        "repositories",
        "duplicateFamily",
        "contamination",
        "budget"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/stableId" },
        "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
        "category": { "type": "string", "minLength": 1 },
        "primaryCapability": { "type": "string", "minLength": 1 },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository" }
        },
        "duplicateFamily": { "$ref": "#/$defs/stableId" },
        "contamination": { "$ref": "#/$defs/contamination" },
        "budget": { "$ref": "#/$defs/budget" },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "atomicClaims": { "type": "integer", "minimum": 1 },
        "reverifyBeforeRun": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": true,
      "required": ["task", "capabilityPoint", "expectedWorkflow", "targetTools"],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "Judge-only oracle answer. Use oracle instead when the answer is computed at run time."
        },
        "oracle": {
          "$ref": "#/$defs/oracle",
          "description": "Run-time or claim-level oracle. Use answer when the exact value is stable."
        },
        "scoring": {
          "$ref": "#/$defs/scoring",
          "description": "Per-question 1.0/0.5/0 rubric. May be omitted only when sharedScoring exists at suite level."
        },
        "capabilityPoint": {
          "type": "string",
          "minLength": 1,
          "description": "Differentiating capability / trajectory condition this question is meant to exercise."
        },
        "task": { "$ref": "#/$defs/task" },
        "expectedWorkflow": {
          "type": "string",
          "minLength": 1,
          "description": "Judge-side expected capability path; exact call order is not required."
        },
        "keyTerms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "criticalKeyTerm": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "type": "string",
          "minLength": 1
        },
        "targetTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lane": {
          "type": "string",
          "description": "Suite-specific capability lane, e.g. parity/beyond."
        },
        "astGrepCeiling": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["answer"],
          "properties": { "answer": true }
        },
        {
          "required": ["oracle"],
          "properties": { "oracle": true }
        }
      ]
    }
  }
}
