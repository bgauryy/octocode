{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octocode-benchmark/kpi",
  "title": "Judged run KPIs — kpi.json emitted per comparison run",
  "description": "Comparison KPIs: correctness, precision, recall, and token cost. Scoring contract: SCORING.md (VRPT, REQ v3 — harmonic mean of 1-10 judge scores). Judged blind per JUDGING.md. Exemplar: fixtures/compare-run-example/kpi.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "date",
    "subjectSha",
    "suiteVersion",
    "questionBankId",
    "provenance",
    "questions",
    "suiteRollups"
  ],
  "properties": {
    "run": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "subjectSha": { "type": "string", "minLength": 1, "description": "Octocode repo SHA the local build was made from, or an explicit synthetic marker in fixtures." },
    "suiteVersion": { "type": "integer", "minimum": 1 },
    "questionBankId": { "$ref": "#/$defs/stableId" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "baselines": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Baseline tool versions, e.g. {\"ast-grep\": \"0.45.0\"}."
    },
    "agentTotals": {
      "type": "object",
      "minProperties": 1,
      "description": "Per suite per arm: runner-reported agent tokens (authoritative when available), tool uses, wall-clock",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "$ref": "#/$defs/agentTotal" }
      }
    },
    "questions": {
      "type": "array",
      "description": "Ordered by suite then q. Within each suite, q must be gapless 1..N.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["suite", "q", "taskId", "topic", "difficulty", "category", "taskStatus", "contaminated", "arms"],
        "properties": {
          "suite": { "type": "string", "minLength": 1 },
          "q": { "type": "integer", "minimum": 1, "maximum": 50 },
          "taskId": { "$ref": "#/$defs/stableId" },
          "topic": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
          "category": { "type": "string", "minLength": 1 },
          "taskStatus": { "enum": ["valid", "invalid"] },
          "targetTools": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "contaminated": { "type": "boolean" },
          "arms": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": { "$ref": "#/$defs/questionArm" }
          }
        }
      }
    },
    "suiteRollups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/suiteRollup" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "settingValue": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "harness", "harnessVersion", "arms"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "harness": { "type": "string", "minLength": 1 },
        "harnessVersion": { "type": "string", "minLength": 1 },
        "arms": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "provider", "modelSettings", "runner", "runnerVersion", "configHash", "toolSurface", "toolVersion"],
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "modelSettings": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "$ref": "#/$defs/settingValue" }
              },
              "runner": { "type": "string", "minLength": 1 },
              "runnerVersion": { "type": "string", "minLength": 1 },
              "configHash": { "$ref": "#/$defs/sha256" },
              "toolSurface": { "type": "string", "minLength": 1 },
              "toolVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "agentTotal": {
      "type": "object",
      "required": ["agentTokens", "toolUses", "wallClockSec"],
      "properties": {
        "agentTokens": { "type": ["integer", "null"], "minimum": 0 },
        "tokenFallback": { "type": "string", "minLength": 1 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cacheReadTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "surfacePreambleBytes": { "type": "integer", "minimum": 0 },
        "toolUses": { "type": "integer", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "wallClockSec": { "type": "number", "minimum": 0 }
      }
    },
    "questionArm": {
      "type": "object",
      "required": ["status", "rawBytes", "readBytes", "calls", "falseConfidence"],
      "properties": {
        "status": { "enum": ["completed", "timeout", "invalid"] },
        "correctness": {
          "description": "v3: judge score 1-10 (mean of 3 parallel judges). v2 legacy: 0 / 0.5 / 1.0.",
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 10 },
            { "enum": [0, 0.5, 1.0] }
          ]
        },
        "precision": { "type": "integer", "minimum": 1, "maximum": 10, "description": "v3: no false outputs / hallucinations (1-10, mean of 3 judges)." },
        "recall": { "type": "integer", "minimum": 1, "maximum": 10, "description": "v3: nothing important missing (1-10, mean of 3 judges)." },
        "judgeStd": { "type": "number", "minimum": 0, "description": "v3: std deviation of judge scores across the 3 parallel judges — high = unreliable question." },
        "quality": { "type": "integer", "minimum": 1, "maximum": 5, "description": "v2 legacy only; replaced by precision+recall in v3." },
        "flow": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Stage-2 sealed-log trajectory grade (JUDGING.md); omitted when no log stage ran." },
        "rawBytes": { "type": "integer", "minimum": 0 },
        "readBytes": { "type": "integer", "minimum": 0 },
        "runnerTokens": { "type": ["integer", "null"], "minimum": 1 },
        "tokenSource": { "enum": ["runner", "estimated"] },
        "estTokens": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "toolUsed": { "type": "boolean" },
        "wallClockSec": { "type": "number", "minimum": 0 },
        "falseConfidence": { "type": "boolean" },
        "falseConfidenceClaims": { "type": "integer", "minimum": 0, "description": "v2 legacy count; optional in v3." },
        "anchorsChecked": { "type": "integer", "minimum": 0, "description": "v2 legacy count; optional in v3." },
        "anchorsHeld": { "type": "integer", "minimum": 0, "description": "v2 legacy count; optional in v3." },
        "vr": { "type": "number", "minimum": 0, "maximum": 1, "description": "v3: harmonic_mean(C,P,R)/10. v2: C*(Q/5)*E*(1-H)." },
        "vrpt": { "type": "number", "minimum": 0, "description": "100k * vr / tokens." },
        "judgeNote": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "required": ["correctness", "precision", "recall", "runnerTokens", "tokenSource", "estTokens", "vr", "vrpt"] }
        }
      ]
    },
    "rollupValue": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "ci95": {
      "type": ["array", "null"],
      "description": "Bootstrap 95% confidence interval [lo, hi].",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "armRollup": {
      "type": "object",
      "required": [
        "eligibleQuestions",
        "timeoutQuestions",
        "invalidQuestions",
        "meanCorrectness",
        "meanPrecision",
        "meanRecall",
        "totalRawBytes",
        "totalReadBytes",
        "falseConfidenceCount"
      ],
      "properties": {
        "eligibleQuestions": { "type": "integer", "minimum": 0 },
        "timeoutQuestions": { "type": "integer", "minimum": 0 },
        "invalidQuestions": { "type": "integer", "minimum": 0 },
        "meanCorrectness": { "$ref": "#/$defs/rollupValue" },
        "meanPrecision": { "$ref": "#/$defs/rollupValue", "description": "Mean precision score (1-10) across eligible questions." },
        "meanRecall": { "$ref": "#/$defs/rollupValue", "description": "Mean recall score (1-10) across eligible questions." },
        "meanQuality": { "$ref": "#/$defs/rollupValue", "description": "v2 legacy." },
        "meanFlow": { "$ref": "#/$defs/rollupValue" },
        "totalRawBytes": { "type": "integer", "minimum": 0 },
        "totalReadBytes": { "type": "integer", "minimum": 0 },
        "reqPerReadKb": { "$ref": "#/$defs/rollupValue", "description": "v1 legacy." },
        "falseConfidenceCount": { "type": "integer", "minimum": 0 },
        "medianVRPT": { "$ref": "#/$defs/rollupValue", "description": "PRIMARY efficiency aggregate per SCORING.md." },
        "meanVRPT": { "$ref": "#/$defs/rollupValue" },
        "medianVR": { "$ref": "#/$defs/rollupValue", "description": "VR >= 0.6 floor gates efficiency verdicts." },
        "medianVRPTci": { "$ref": "#/$defs/ci95", "description": "Bootstrap 95% CI [lo, hi] of medianVRPT (>=10k resamples). Required for a verdict-eligible run." },
        "meanCorrectnessCi": { "$ref": "#/$defs/ci95", "description": "Bootstrap 95% CI [lo, hi] of meanCorrectness. Required for a verdict-eligible run." },
        "passAt1": { "$ref": "#/$defs/rollupValue", "description": "pass@1 mean correctness across eligible questions." },
        "passHatK": { "type": ["boolean", "null"], "description": "pass^k: all k solvers scored Correctness >= 8 on every eligible question." },
        "tokenSource": { "enum": ["runner", "estimated"], "description": "runner => VRPT is verdict-eligible; estimated => VRPT-est (byte proxy), DRAFT only per SCORING.md." },
        "toolPropertyKPIs": {
          "type": "object",
          "description": "Tool emission properties per SCORING.md.",
          "properties": {
            "readTokensMedian": { "$ref": "#/$defs/rollupValue" },
            "readTokensP90": { "$ref": "#/$defs/rollupValue" },
            "readTokensCV": { "$ref": "#/$defs/rollupValue" },
            "rawBytesMedian": { "$ref": "#/$defs/rollupValue" },
            "rawBytesP90": { "$ref": "#/$defs/rollupValue" },
            "signalRatioMedian": { "$ref": "#/$defs/rollupValue" }
          }
        }
      }
    },
    "suiteRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionCount",
        "contaminatedQuestionCount",
        "invalidQuestionCount",
        "eligibilityRule",
        "scoringVersion",
        "reqFormula",
        "reqPrecision",
        "arms",
        "verdict"
      ],
      "properties": {
        "questionCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "contaminatedQuestionCount": { "type": "integer", "minimum": 0 },
        "invalidQuestionCount": { "type": "integer", "minimum": 0 },
        "eligibilityRule": { "const": "taskStatus=valid && contaminated=false && arm.status=completed" },
        "scoringVersion": { "enum": ["req-v1", "vrpt-v2", "vrpt-v3"] },
        "reqFormula": {
          "enum": [
            "meanCorrectness * (meanQuality / 5) * (meanFlow / 5) / (totalReadBytes / 1024)",
            "median over questions of: 100000 * C * (Q/5) * E * (1 - H) / tokens",
            "median over questions of: 100000 * harmonic_mean(C,P,R)/10 / tokens"
          ]
        },
        "reqPrecision": { "type": "integer", "minimum": 0, "maximum": 8 },
        "arms": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/armRollup" }
        },
        "verdict": { "type": "string", "minLength": 1 }
      }
    }
  }
}
