{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "octocode-benchmark/questions-input",
  "title": "Suite questions — solver-facing input contract",
  "description": "Questions live in each suite's questions.md (human-readable, frozen once any solver starts, NEVER contains answers). This schema is the machine-readable mirror a runner may generate from it to seal solver prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "suiteVersion", "questionBankId", "questions"],
  "properties": {
    "suite": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "integer", "minimum": 1 },
    "questionBankId": { "$ref": "#/$defs/stableId" },
    "frozenAt": { "type": "string", "format": "date" },
    "questions": {
      "type": "array",
      "description": "Ordered, gapless questions. q must equal its one-based array position (1..N); the verifier enforces this data-dependent invariant.",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 of the canonical frozen question-bank payload."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "description": "GitHub owner/repository."
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Resolved immutable Git commit."
        }
      }
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cutoff"],
      "properties": {
        "status": {
          "enum": ["unknown", "control-required", "uncontaminated", "contaminated", "excluded"]
        },
        "cutoff": {
          "type": "string",
          "minLength": 1,
          "description": "Pre-registered control rule used to classify contamination."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxToolCalls", "maxPages", "timeoutMs"],
      "properties": {
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "maxPages": { "type": "integer", "minimum": 0 },
        "maxRunnerTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      },
      "description": "Deterministic per-task limits; omitted limits are not inferred from runner defaults."
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "taskId",
        "text",
        "targetTools",
        "repositories",
        "difficulty",
        "duplicateFamily",
        "contamination",
        "budget"
      ],
      "properties": {
        "q": { "type": "integer", "minimum": 1, "maximum": 50 },
        "taskId": { "$ref": "#/$defs/stableId" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim question. No answers and no hints toward the oracle."
        },
        "targetTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Tools or equivalent surface capabilities this task is designed to exercise."
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository" }
        },
        "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
        "category": { "type": "string", "minLength": 1 },
        "duplicateFamily": { "$ref": "#/$defs/stableId" },
        "contamination": { "$ref": "#/$defs/contamination" },
        "budget": { "$ref": "#/$defs/budget" },
        "capabilityPoint": {
          "type": "string",
          "minLength": 1,
          "description": "The differentiating capability the trajectory grader checks."
        },
        "expectedWorkflow": {
          "type": "string",
          "minLength": 1,
          "description": "Judge-facing capability path, without answer content."
        }
      }
    }
  }
}
