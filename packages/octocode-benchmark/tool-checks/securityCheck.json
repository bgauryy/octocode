{
 "tool": "securityCheck",
 "steps": [
  {
   "name": "vulnerable npm version",
   "tool": "securityCheck",
   "args": {
    "operation": "package",
    "ecosystem": "npm",
    "packageName": "lodash",
    "version": "4.17.20"
   },
   "expect": {
    "has": [
     "data.advisoryIds"
    ]
   }
  },
  {
   "name": "unpublished malicious version",
   "tool": "securityCheck",
   "args": {
    "operation": "package",
    "ecosystem": "npm",
    "packageName": "event-stream",
    "version": "3.3.6"
   },
   "expect": {
    "status": "ok",
    "has": [
     "data.versionListed",
     "data.advisoryIds"
    ],
    "contains": [
     "GHSA-mh6f-8j2x-4483",
     "\"affected\":true",
     "do not install it"
    ],
    "offers": "related:securityCheck"
   }
  },
  {
   "name": "unpublished version no record names",
   "tool": "securityCheck",
   "args": {
    "operation": "package",
    "ecosystem": "npm",
    "packageName": "lodash",
    "version": "4.17.99"
   },
   "expect": {
    "error": "notFound",
    "offers": "related:securityCheck"
   }
  },
  {
   "name": "a range warns it checked one version",
   "tool": "securityCheck",
   "args": {
    "operation": "package",
    "ecosystem": "npm",
    "packageName": "lodash",
    "version": "^4.17.0"
   },
   "expect": {
    "maxChars": 20000
   }
  },
  {
   "name": "three packages in one call",
   "tool": "securityCheck",
   "args": {
    "queries": [
     {
      "mainGoal": "c",
      "reasoning": "c",
      "operation": "package",
      "ecosystem": "npm",
      "packageName": "lodash",
      "version": "4.17.21"
     },
     {
      "mainGoal": "c",
      "reasoning": "c",
      "operation": "package",
      "ecosystem": "npm",
      "packageName": "minimist",
      "version": "1.2.5"
     },
     {
      "mainGoal": "c",
      "reasoning": "c",
      "operation": "package",
      "ecosystem": "crates.io",
      "packageName": "grep-searcher",
      "version": "0.1.6"
     }
    ]
   },
   "expect": {
    "has": [
     "$.results"
    ]
   }
  },
  {
   "name": "unsupported ecosystem",
   "tool": "securityCheck",
   "args": {
    "operation": "package",
    "ecosystem": "cobol",
    "packageName": "x",
    "version": "1"
   },
   "expect": {
    "error": "invalidInput"
   }
  }
 ]
}
