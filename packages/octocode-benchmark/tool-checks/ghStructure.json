{
 "tool": "ghStructure",
 "steps": [
  {
   "name": "root listing",
   "tool": "ghStructure",
   "args": {
    "operation": "tree",
    "owner": "sharkdp",
    "repo": "fd",
    "maxDepth": 1
   },
   "expect": {
    "contains": [
     "Cargo.toml"
    ],
    "offers": "related:ghGetFileContent"
   }
  },
  {
   "name": "follow the guide read (README/AGENTS)",
   "follow": "related:ghGetFileContent",
   "expect": {
    "has": [
     "data.content"
    ]
   }
  },
  {
   "name": "refs",
   "tool": "ghStructure",
   "args": {
    "operation": "refs",
    "owner": "sharkdp",
    "repo": "fd",
    "limit": 3
   },
   "expect": {
    "has": [
     "data.tags"
    ]
   }
  },
  {
   "name": "follow refs next page",
   "follow": "next",
   "expect": {
    "has": [
     "data.tags"
    ]
   }
  },
  {
   "name": "subfolder at a tag",
   "tool": "ghStructure",
   "args": {
    "operation": "tree",
    "owner": "sharkdp",
    "repo": "fd",
    "ref": "v10.2.0",
    "path": "src",
    "maxDepth": 1
   },
   "expect": {
    "contains": [
     "main.rs"
    ]
   }
  },
  {
   "name": "missing folder",
   "tool": "ghStructure",
   "args": {
    "operation": "tree",
    "owner": "sharkdp",
    "repo": "fd",
    "path": "no/such/dir"
   },
   "expect": {
    "error": "notFound"
   }
  }
 ]
}
