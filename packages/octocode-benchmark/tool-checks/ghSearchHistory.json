{
 "tool": "ghSearchHistory",
 "steps": [
  {
   "name": "recent PRs",
   "tool": "ghSearchHistory",
   "args": {
    "operation": "pullRequest",
    "owner": "sharkdp",
    "repo": "fd",
    "limit": 3
   },
   "expect": {
    "min": {
     "data.pullRequests[]": 1
    }
   }
  },
  {
   "name": "commits",
   "tool": "ghSearchHistory",
   "args": {
    "operation": "commit",
    "owner": "BurntSushi",
    "repo": "ripgrep",
    "limit": 3
   },
   "expect": {
    "maxChars": 20000
   }
  },
  {
   "name": "then read one PR",
   "tool": "ghGetHistoryItem",
   "args": {
    "operation": "pullRequest",
    "owner": "sharkdp",
    "repo": "fd",
    "number": 1800
   },
   "expect": {
    "has": [
     "data"
    ]
   }
  },
  {
   "name": "bad operation",
   "tool": "ghSearchHistory",
   "args": {
    "operation": "tickets",
    "owner": "sharkdp",
    "repo": "fd"
   },
   "expect": {
    "error": "invalidInput"
   }
  }
 ]
}
