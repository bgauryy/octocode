{
 "tool": "localSearch",
 "steps": [
  {
   "name": "find a definition",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates",
    "matchString": [
     "fn walk_builder"
    ]
   },
   "expect": {
    "contains": [
     "walk.rs"
    ],
    "offers": "related:lspSearch"
   }
  },
  {
   "name": "follow: callers of the hit",
   "follow": "related:lspSearch",
   "expect": {
    "min": {
     "data.files[]": 1
    }
   }
  },
  {
   "name": "modifier-first definition offers callers",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates/runtime-base/src/response",
    "matchString": [
     "pub fn push_warnings"
    ]
   },
   "expect": {
    "offers": "related:lspSearch"
   }
  },
  {
   "name": "counts across the scope",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates",
    "matchString": [
     "push_warnings"
    ],
    "view": "countMatches"
   },
   "expect": {
    "min": {
     "data.files[]": 1
    }
   }
  },
  {
   "name": "matchOnly spans",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates",
    "matchString": [
     "push_warnings"
    ],
    "view": "matchOnly",
    "limit": 5
   },
   "expect": {
    "min": {
     "data.files[]": 1
    }
   }
  },
  {
   "name": "paged search, page 1",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates",
    "matchString": [
     "Arc::clone"
    ],
    "limit": 50
   },
   "expect": {
    "offers": "next:nextPage"
   }
  },
  {
   "name": "paged search, page 2",
   "follow": "next:nextPage",
   "expect": {
    "min": {
     "data.files[]": 1
    }
   }
  },
  {
   "name": "absent term: absence proof and a lead",
   "tool": "localSearch",
   "args": {
    "path": ".",
    "matchString": [
     "zzqx_never_here_[4]2"
    ],
    "regexEngine": "rust"
   },
   "expect": {
    "status": "empty",
    "maxChars": 4000,
    "offers": "related:localSearch"
   }
  },
  {
   "name": "follow the skipped-path lead",
   "follow": "related:localSearch",
   "expect": {
    "maxChars": 20000
   }
  },
  {
   "name": "bad caseMode",
   "tool": "localSearch",
   "args": {
    "path": "packages/octocode-native/crates",
    "matchString": [
     "x"
    ],
    "caseMode": "loud"
   },
   "expect": {
    "error": "invalidInput"
   }
  }
 ]
}
