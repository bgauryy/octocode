{
  "description": "S13 arm: octocode with the tools.family preset chosen per session by the host rule familySelector=checkout (a session opened in a local checkout gets local+remote tools, otherwise github+remote).",
  "tools": "",
  "allowedTools": [
    "mcp__octocode"
  ],
  "mcpServers": {
    "octocode": {
      "command": "node",
      "args": [
        "${REPO_ROOT}/packages/octocode-mcp/dist/index.js"
      ],
      "env": {
        "ENABLE_LOCAL": "true",
        "WORKSPACE_ROOT": "${CORPUS_ROOT}",
        "ALLOWED_PATHS": "${CORPUS_PATHS}"
      }
    }
  },
  "addCorpusDirs": false,
  "isolation": {
    "allowedToolPattern": "^mcp__octocode__",
    "requiredMcpServers": [
      "octocode"
    ]
  },
  "counters": [
    {
      "label": "clasify calls",
      "tool": "clasify$"
    },
    {
      "label": "matchString queries",
      "inputKey": "matchString"
    },
    {
      "label": "lspSearch calls",
      "tool": "lspSearch$"
    },
    {
      "label": "astSearch calls",
      "tool": "astSearch$"
    }
  ],
  "familySelector": "checkout"
}
