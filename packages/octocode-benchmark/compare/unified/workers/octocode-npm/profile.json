{
  "description": "Published octocode-mcp@19.1.0 from npm (npx, exact pin), local + GitHub tools. Same WORKER.md as octocode; the build under test is the only difference. No built-in Claude Code tools.",
  "tools": "",
  "allowedTools": [
    "mcp__octocode"
  ],
  "mcpServers": {
    "octocode": {
      "command": "npx",
      "args": [
        "-y",
        "octocode-mcp@19.1.0"
      ],
      "cwd": "/tmp",
      "env": {
        "OCTOCODE_ENABLE_LOCAL": "true",
        "WORKSPACE_ROOT": "${CORPUS_ROOT}",
        "ALLOWED_PATHS": "${CORPUS_PATHS}"
      }
    }
  },
  "addCorpusDirs": false,
  "isolation": {
    "allowedToolPattern": "^mcp__octocode__",
    "requiredMcpServers": [
      "octocode"
    ]
  },
  "counters": [
    {
      "label": "clasify calls",
      "tool": "clasify$"
    },
    {
      "label": "matchString queries",
      "inputKey": "matchString"
    },
    {
      "label": "lspSearch calls",
      "tool": "lspSearch$"
    },
    {
      "label": "astSearch calls",
      "tool": "astSearch$"
    }
  ]
}
