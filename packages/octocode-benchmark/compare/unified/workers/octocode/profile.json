{
  "description": "Octocode MCP server (latest local build), local + GitHub tools, clasify available. No built-in Claude Code tools.",
  "tools": "",
  "allowedTools": ["mcp__octocode"],
  "mcpServers": {
    "octocode": {
      "command": "node",
      "args": ["${REPO_ROOT}/packages/octocode-mcp/dist/index.js"],
      "env": { "ENABLE_LOCAL": "true", "WORKSPACE_ROOT": "${CORPUS_ROOT}", "ALLOWED_PATHS": "${CORPUS_PATHS}" }
    }
  },
  "addCorpusDirs": false,
  "isolation": { "allowedToolPattern": "^mcp__octocode__", "requiredMcpServers": ["octocode"] },
  "counters": [
    { "label": "clasify calls", "tool": "clasify$" },
    { "label": "matchString queries", "inputKey": "matchString" },
    { "label": "lspSearch calls", "tool": "lspSearch$" },
    { "label": "astSearch calls", "tool": "astSearch$" },
    { "label": "followUp uses", "inputKey": "followUp" }
  ]
}
