    { "id": "tg-04", "graph": "tool-graph", "kind": "partial", "query": "unused exports",
      "expect": ["src/ast_graph/store/detect/reach.rs#detect_unused_exports"], "cite": ["src/ast_graph/store/detect/reach.rs:233"] },
    { "id": "tg-05", "graph": "tool-graph", "kind": "intent", "query": "where are import cycles between files detected",
