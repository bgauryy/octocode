{
  "name": "graph-search",
  "about": "Labelled search questions for octocode-graph `search`: each names the graph it runs on, the query an agent types, and every file#symbol that answers it, cited where the code was read. An answer counts when a ranked row's symbol is one of them (an overload's `@N` suffix ignored). `typed` is the same question as signature filters (F12); the scorer runs it only when the graph's symbols carry params or returns.",
  "kinds": {
    "exact": "the whole name as written",
    "partial": "some of the name's words",
    "intent": "what the code does, in words its name does not hold",
    "type": "a question about parameter and return types"
  },
  "graphs": {
    "octocode-graph": {
      "repository": "this repository, packages/octocode-graph at 2f85da966 plus the working tree of 2026-11-24",
      "build": "a copy of packages/octocode-graph/{src,package.json,tsconfig.json} as directory octocode-graph; from its parent: node packages/octocode-graph/src/runtime/commands/build.ts octocode-graph --out <dir> --lsp off"
    },
    "tool-graph": {
      "repository": "this repository, packages/octocode-native/crates/tool-graph at 2f85da966 plus the working tree of 2026-11-24",
      "build": "a copy of crates/tool-graph/{src,Cargo.toml} as directory tool-graph; from its parent: node packages/octocode-graph/src/runtime/commands/build.ts tool-graph --out <dir> --lsp off"
    },
    "django": {
      "repository": "local/repos/python (django/django 4fab678a0739d54401ccee7eb587553657c9f76e), directory django",
      "build": "from packages/octocode-benchmark/local/repos: node ../../../octocode-graph/src/runtime/commands/build.ts python/django --out <dir> --lsp off"
    },
    "typescript-packages": {
      "repository": "local/repos/typescript (microsoft/TypeScript 4f5ddae224b9529a69b571f631fe3a2cb283162f), directory packages",
      "build": "from packages/octocode-benchmark/local/repos: node ../../../octocode-graph/src/runtime/commands/build.ts typescript/packages --out <dir> --lsp off"
    }
  },
  "questions": [
    { "id": "og-01", "graph": "octocode-graph", "kind": "exact", "query": "cycleGroups",
      "expect": ["src/algorithms.ts#cycleGroups"], "cite": ["src/algorithms.ts:62"] },
    { "id": "og-02", "graph": "octocode-graph", "kind": "exact", "query": "resolveSymbol",
      "expect": ["src/runtime/query-index.ts#resolveSymbol"], "cite": ["src/runtime/query-index.ts:520"] },
    { "id": "og-03", "graph": "octocode-graph", "kind": "partial", "query": "edit distance",
      "expect": ["src/runtime/query-forgiving.ts#editDistance"], "cite": ["src/runtime/query-forgiving.ts:59"] },
    { "id": "og-04", "graph": "octocode-graph", "kind": "partial", "query": "shortest ring",
      "expect": ["src/algorithms.ts#shortestRing"], "cite": ["src/algorithms.ts:79"] },
    { "id": "og-05", "graph": "octocode-graph", "kind": "intent", "query": "where are dependency cycles counted",
      "expect": ["src/runtime/metrics.ts#cycleSets", "src/algorithms.ts#cycleGroups"],
      "cite": ["src/runtime/metrics.ts:38-40", "src/algorithms.ts:59-62"] },
    { "id": "og-06", "graph": "octocode-graph", "kind": "intent", "query": "detect clusters of files that belong together",
      "expect": ["src/algorithms.ts#louvain", "src/runtime/metrics.ts#communitySets"],
      "cite": ["src/algorithms.ts:241-243", "src/runtime/metrics.ts:80-81"] },
    { "id": "og-07", "graph": "octocode-graph", "kind": "intent", "query": "reconnect with backoff when the connection drops",
      "expect": ["src/assets/live.ts#connect"], "cite": ["src/assets/live.ts:560-589"] },
    { "id": "og-08", "graph": "octocode-graph", "kind": "intent", "query": "rank files by importance",
      "expect": ["src/algorithms.ts#pagerank"], "cite": ["src/algorithms.ts:146-148"] },
    { "id": "og-09", "graph": "octocode-graph", "kind": "intent", "query": "which files changed after the graph was written",
      "expect": ["src/runtime/query.ts#editedSince", "src/runtime/query.ts#withStaleness"],
      "cite": ["src/runtime/query.ts:116-117", "src/runtime/query.ts:131"] },
    { "id": "og-10", "graph": "octocode-graph", "kind": "intent", "query": "suggest the closest name for a misspelled word",
      "expect": ["src/runtime/query-forgiving.ts#nearest", "src/runtime/query-forgiving.ts#editDistance"],
      "cite": ["src/runtime/query-forgiving.ts:86-87", "src/runtime/query-forgiving.ts:58-59"] },
    { "id": "og-11", "graph": "octocode-graph", "kind": "intent", "query": "map a position in generated code back to the original source",
      "expect": ["src/runtime/sourcemap.ts#originalPosition"], "cite": ["src/runtime/sourcemap.ts:166-167"] },
    { "id": "og-12", "graph": "octocode-graph", "kind": "type", "query": "function taking a Buffer and returning a Frame",
      "typed": "--param Buffer --returns Frame",
      "expect": ["src/runtime/ws.ts#parseFrame"], "cite": ["src/runtime/ws.ts:74"] },
    { "id": "og-13", "graph": "octocode-graph", "kind": "type", "query": "what returns a QueryResult",
      "typed": "--returns QueryResult",
      "expect": ["src/runtime/query-api.ts#runQuery"], "cite": ["src/runtime/query-api.ts:200"] },

    { "id": "tg-01", "graph": "tool-graph", "kind": "exact", "query": "tarjan",
      "expect": ["src/ast_graph/store/detect/primitives.rs#tarjan"], "cite": ["src/ast_graph/store/detect/primitives.rs:18"] },
    { "id": "tg-02", "graph": "tool-graph", "kind": "exact", "query": "git_changed",
      "expect": ["src/ast_graph/store/query/assess/changed.rs#git_changed"], "cite": ["src/ast_graph/store/query/assess/changed.rs:38"] },
    { "id": "tg-03", "graph": "tool-graph", "kind": "partial", "query": "articulation",
