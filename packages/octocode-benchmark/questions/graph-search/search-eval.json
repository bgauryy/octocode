    { "id": "tg-10", "graph": "tool-graph", "kind": "intent", "query": "encode signed integers as unsigned for variable-length storage",
      "expect": ["src/ast_graph/store/format/writer.rs#zigzag", "src/ast_graph/store/format/reader.rs#unzigzag"],
      "cite": ["src/ast_graph/store/format/writer.rs:42-44", "src/ast_graph/store/format/reader.rs:5"] },
    { "id": "tg-11", "graph": "tool-graph", "kind": "intent", "query": "smallest set of edges whose removal breaks a cycle",
      "expect": ["src/ast_graph/store/detect/primitives.rs#feedback_arcs"], "cite": ["src/ast_graph/store/detect/primitives.rs:34-38"] },
    { "id": "tg-12", "graph": "tool-graph", "kind": "type", "query": "function returning Vec<f64> scores",
      "typed": "--returns Vec<f64>",
      "expect": ["src/ast_graph/algorithms.rs#page_rank", "src/ast_graph/store/detect/view.rs#View.page_rank"],
      "cite": ["src/ast_graph/algorithms.rs:172", "src/ast_graph/store/detect/view.rs:159"] },

