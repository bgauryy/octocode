{
  "name": "@octocodeai/octocode-tools-core",
  "description": "Core tool implementations for Octocode: GitHub, local filesystem, LSP, and package search tools.",
  "version": "18.3.0",
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "bugs": "https://github.com/bgauryy/octocode/issues",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@npmcli/config": "^11.0.1",
    "@octocodeai/config": "18.3.0",
    "@octocodeai/octocode-core": "18.3.0",
    "@octocodeai/octocode-engine": "18.3.0",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/openapi-types": "^29.0.1",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/request": "^10.0.16",
    "node-cache": "^5.1.2",
    "npm-registry-fetch": "^20.0.1",
    "octokit": "^5.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@octokit/core": "^7.0.8",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./direct": {
      "types": "./dist/direct.d.ts",
      "import": "./dist/direct.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./credentials": {
      "types": "./dist/shared/credentials/index.d.ts",
      "import": "./dist/shared/credentials/index.js"
    },
    "./platform": {
      "types": "./dist/shared/platform/index.d.ts",
      "import": "./dist/shared/platform/index.js"
    },
    "./session": {
      "types": "./dist/shared/session/index.d.ts",
      "import": "./dist/shared/session/index.js"
    },
    "./config": {
      "types": "./dist/shared/config/index.d.ts",
      "import": "./dist/shared/config/index.js"
    },
    "./paths": {
      "types": "./dist/shared/paths.d.ts",
      "import": "./dist/shared/paths.js"
    },
    "./fs-utils": {
      "types": "./dist/shared/fs-utils.d.ts",
      "import": "./dist/shared/fs-utils.js"
    },
    "./testing": {
      "types": "./dist/shared/credentials/testing.d.ts",
      "import": "./dist/shared/credentials/testing.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-tools-core"
  },
  "scripts": {
    "build": "yarn readme:sync && yarn clean && node ../../scripts/esbuild-package.mjs && yarn build:types-deps && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:dev": "yarn readme:sync && node ../../scripts/esbuild-package.mjs && yarn build:types-deps && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:types-deps": "yarn workspace @octocodeai/config build",
    "clean": "rm -rf dist/",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepack": "yarn readme:sync && node ../octocode/scripts/check-no-workspace-protocol.mjs",
    "prepublishOnly": "node ../octocode/scripts/check-no-workspace-protocol.mjs",
    "readme:sync": "node ../../scripts/sync-package-readmes.mjs .",
    "test": "vitest run --coverage",
    "test:quiet": "vitest run --reporter=dot --silent",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "verify": "yarn lint && yarn typecheck && yarn test"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
