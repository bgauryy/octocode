{
  "name": "@octocodeai/octocode-extension-rust",
  "version": "0.1.0",
  "description": "Native filesystem integrity and text primitives for the Octocode extension",
  "license": "MIT",
  "type": "module",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "platforms.cjs",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:dev": "node scripts/build.mjs",
    "test": "cargo test --locked && node scripts/build.mjs --release && node --test tests/*.test.mjs",
    "test:rust": "cargo test",
    "lint": "cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit --skipLibCheck --types node --module nodenext --moduleResolution nodenext index.d.ts",
    "verify": "yarn lint && yarn typecheck && yarn test",
    "build:all": "node scripts/build.mjs --release --all",
    "test:node": "node --test tests/*.test.mjs",
    "platforms:check": "node scripts/check-platforms.mjs",
    "version:check": "node scripts/metadata.mjs",
    "version:sync": "node scripts/metadata.mjs --write",
    "prepublishOnly": "yarn version:check && yarn platforms:check",
    "build:darwin-arm64": "node scripts/build.mjs --release --target darwin-arm64",
    "build:darwin-x64": "node scripts/build.mjs --release --target darwin-x64",
    "build:linux-x64-gnu": "node scripts/build.mjs --release --target linux-x64-gnu",
    "build:linux-x64-musl": "node scripts/build.mjs --release --target linux-x64-musl",
    "build:linux-arm64-gnu": "node scripts/build.mjs --release --target linux-arm64-gnu",
    "build:win32-x64-msvc": "node scripts/build.mjs --release --target win32-x64-msvc"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgauryy/octocode.git",
    "directory": "packages/octocode-extension-rust"
  },
  "optionalDependencies": {
    "@octocodeai/octocode-extension-rust-darwin-arm64": "0.1.0",
    "@octocodeai/octocode-extension-rust-darwin-x64": "0.1.0",
    "@octocodeai/octocode-extension-rust-linux-arm64-gnu": "0.1.0",
    "@octocodeai/octocode-extension-rust-linux-x64-gnu": "0.1.0",
    "@octocodeai/octocode-extension-rust-linux-x64-musl": "0.1.0",
    "@octocodeai/octocode-extension-rust-win32-x64-msvc": "0.1.0"
  },
  "napi": {
    "binaryName": "octocode-extension-rust",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
