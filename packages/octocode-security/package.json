{
  "name": "octocode-security",
  "version": "0.1.0",
  "description": "Rust-backed secret detection for Node.js — replaces octocode-security-utils",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contentSanitizer": {
      "types": "./dist/contentSanitizer.d.ts",
      "import": "./dist/contentSanitizer.js"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "import": "./dist/mask.js"
    },
    "./pathValidator": {
      "types": "./dist/pathValidator.d.ts",
      "import": "./dist/pathValidator.js"
    },
    "./commandValidator": {
      "types": "./dist/commandValidator.d.ts",
      "import": "./dist/commandValidator.js"
    },
    "./withSecurityValidation": {
      "types": "./dist/withSecurityValidation.d.ts",
      "import": "./dist/withSecurityValidation.js"
    },
    "./ignoredPathFilter": {
      "types": "./dist/ignoredPathFilter.d.ts",
      "import": "./dist/ignoredPathFilter.js"
    },
    "./pathUtils": {
      "types": "./dist/pathUtils.d.ts",
      "import": "./dist/pathUtils.js"
    },
    "./paramExtractors": {
      "types": "./dist/paramExtractors.d.ts",
      "import": "./dist/paramExtractors.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./regexes": {
      "types": "./dist/regexes/index.d.ts",
      "import": "./dist/regexes/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contentSanitizer": [
        "./dist/contentSanitizer.d.ts"
      ],
      "mask": [
        "./dist/mask.d.ts"
      ],
      "pathValidator": [
        "./dist/pathValidator.d.ts"
      ],
      "commandValidator": [
        "./dist/commandValidator.d.ts"
      ],
      "withSecurityValidation": [
        "./dist/withSecurityValidation.d.ts"
      ],
      "ignoredPathFilter": [
        "./dist/ignoredPathFilter.d.ts"
      ],
      "pathUtils": [
        "./dist/pathUtils.d.ts"
      ],
      "paramExtractors": [
        "./dist/paramExtractors.d.ts"
      ],
      "registry": [
        "./dist/registry.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "regexes": [
        "./dist/regexes/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "octocode-security",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:rust": "node scripts/gen-patterns.mjs && napi build --platform --release",
    "build:ts": "node build.mjs && tsc --emitDeclarationOnly",
    "build": "yarn build:rust && yarn build:ts",
    "build:dev": "node scripts/gen-patterns.mjs && napi build --platform && node build.mjs && tsc --emitDeclarationOnly",
    "gen": "node scripts/gen-patterns.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "lint:rust": "cargo clippy --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "verify": "yarn verify:patterns && yarn typecheck && yarn lint:rust && yarn audit",
    "verify:patterns": "node scripts/gen-patterns.mjs && git diff --exit-code src/patterns.rs || (echo 'ERROR: src/patterns.rs is out of sync with the TS source — run yarn gen and commit the result' && exit 1)",
    "bench": "node bench/compare.mjs",
    "test": "vitest run --coverage",
    "test:quiet": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "audit": "cargo audit -D unmaintained -D unsound -D yanked"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@napi-rs/cli": "^3.7.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "author": "Guy Bary <bgauryy@octocodeai.com>"
}
