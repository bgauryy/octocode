{
  "name": "@octocodeai/pi-extension",
  "version": "19.2.0",
  "description": "Octocode for Pi: guarded file tools, MCP (with Octocode research built in), skills, subagents, web + browser tools, and a focused system prompt.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "pi",
    "pi-package",
    "mcp",
    "skills"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-pi-extension"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "themes/**",
    "subagents/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "octocode-mcp": "19.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.2",
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.2",
    "typebox": "^1.3.30",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ../../node_modules/eslint/bin/eslint.js . --config eslint.config.mjs --no-warn-ignored && tsc --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "verify": "yarn lint && yarn test && yarn build",
    "prepack": "yarn build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.99.2",
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "octocode-pi-api": "./dist/api/cli.js"
  }
}
