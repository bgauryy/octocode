{
  "name": "@octocodeai/pi-extension",
  "version": "19.2.0",
  "description": "Octocode for Pi: guarded file tools, MCP (with Octocode research built in), skills, subagents, web + browser tools, and a focused system prompt.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "pi",
    "pi-package",
    "mcp",
    "skills"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-pi-extension"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "themes/**",
    "subagents/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@earendil-works/pi-mcp": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "octocode-mcp": "^20.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.37",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-pi.mjs",
    "casefold:generate": "node scripts/generate-casefold.mjs",
    "clean": "rm -rf dist",
    "typecheck": "yarn run -T tsgo --noEmit -p tsconfig.json",
    "lint": "yarn run -T oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .",
    "format": "yarn run -T prettier --write src scripts tests vitest.config.ts",
    "format:check": "yarn run -T prettier --check src scripts tests vitest.config.ts",
    "test": "vitest run --coverage",
    "test:chrome": "PI_TEST_CHROME=1 vitest run chrome.test",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn build",
    "prepack": "yarn clean && yarn build"
  },
  "pi": {
    "extensions": [
      "./dist/pi-entry.cjs"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "octocode-pi-api": "./dist/api/cli.js"
  }
}
