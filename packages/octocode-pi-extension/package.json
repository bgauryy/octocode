{
  "name": "@octocodeai/pi-extension",
  "version": "19.2.0",
  "description": "Official Octocode Pi package: research CLI and MCP integration, support tools, skills, prompts, and agent coordination.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "pi",
    "pi-package",
    "skills"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-pi-extension"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "themes/**",
    "docs/**",
    ".env.example",
    "README.md",
    "HARNESS.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@earendil-works/pi-tui": "^0.85.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@octocodeai/agent-contracts": "0.1.0",
    "@octocodeai/agent-core": "0.1.0",
    "@octocodeai/config": "20.0.0",
    "@octocodeai/octocode-awareness": "2.1.0",
    "@octocodeai/octocode-engine": "19.2.0",
    "@octocodeai/octocode-extension-rust": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "chrome-launcher": "^1.2.1",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.0.12",
    "octocode": "19.2.0",
    "octocode-mcp": "19.2.0",
    "smol-toml": "^1.8.0",
    "typebox": "^1.3.30",
    "undici": "^8.10.2",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@octocodeai/agent-testing": "^0.1.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "bundledDependencies": [
    "@octocodeai/agent-contracts",
    "@octocodeai/config"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:skills": "node scripts/build.mjs --skills-only",
    "clean": "node scripts/build.mjs --clean",
    "lint": "node ../../node_modules/eslint/bin/eslint.js . --config eslint.config.mjs --no-warn-ignored && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn build && node ../../node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run --maxWorkers=4",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --watch",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "verify": "yarn build && yarn typecheck && node ../../node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "check:no-workspace": "node scripts/check-no-workspace-protocol.mjs",
    "prepack": "node scripts/check-no-workspace-protocol.mjs && yarn build",
    "prepublishOnly": "yarn check:no-workspace"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "themes": [
      "./themes"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  }
}
