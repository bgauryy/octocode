{
  "name": "@octocodeai/pi-extension",
  "version": "18.3.0",
  "description": "Official Octocode Pi package: native tools, npx CLI wiring, Awareness skill assets, prompts, and harness wiring.",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "octocode",
    "pi",
    "pi-package",
    "skills"
  ],
  "author": "Guy Bary <bgauryy@octocodeai.com>",
  "homepage": "https://octocode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgauryy/octocode-mcp.git",
    "directory": "packages/octocode-pi-extension"
  },
  "bugs": "https://github.com/bgauryy/octocode-mcp/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js",
      "default": "./dist/shell/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "themes/**",
    "docs/**",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.4",
    "@modelcontextprotocol/client": "^2.0.0",
    "@octocodeai/agent-core": "0.1.0",
    "@octocodeai/octocode-awareness": "^1.5.0",
    "@octocodeai/octocode-engine": "18.3.0",
    "@octocodeai/octocode-shared": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "chrome-launcher": "^1.2.1",
    "marked": "^18.0.5",
    "octocode": "^18.3.0",
    "octocode-mcp": "^18.3.0",
    "smol-toml": "^1.8.0",
    "typebox": "^1.3.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@octocodeai/agent-testing": "^0.1.0",
    "@octocodeai/config": "18.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:skills": "node scripts/build.mjs --skills-only",
    "clean": "node scripts/build.mjs --clean",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "yarn lint",
    "test": "yarn build && node ../../node_modules/vitest/vitest.mjs run",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --watch",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "verify": "yarn typecheck && yarn test",
    "check:no-workspace": "node scripts/check-no-workspace-protocol.mjs",
    "prepack": "node scripts/check-no-workspace-protocol.mjs && yarn build",
    "prepublishOnly": "yarn check:no-workspace"
  },
  "pi": {
    "extensions": [
      "./dist/octocode/index.js"
    ],
    "themes": [
      "./themes"
    ]
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "octocode": {
    "readmeSync": false
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
