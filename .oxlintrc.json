// The one oxlint config for every workspace; each lint script runs
// `oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --report-unused-disable-directives .`.
// Violations that predate a rule live in .oxlintrc.baseline.json, which may only shrink
// (skills-dev/octocode-dev/scripts/oxlint-baseline.mjs).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.baseline.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/out/**",
    "**/coverage/**",
    "**/*.d.ts",
    "**/*.d.mts",
    "**/*.generated.*",
    "**/fixtures/**",
    "**/examples/**",
    "packages/octocode-benchmark/local/repos/**",
    "packages/octocode-benchmark/local/e2e/seeded/**",
    "packages/octocode-native/npm/**",
    "packages/octocode-native/target/**",
    "skills/**",
    ".octocode/**",
    ".claude/**"
  ],
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": false, "skipComments": false }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": false, "skipComments": false }],
    "complexity": ["error", { "max": 15 }],
    "max-depth": ["error", { "max": 4 }],
    "max-params": ["error", { "max": 4 }],
    "no-console": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "prefer-const": "error",
    "no-var": "error",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-useless-escape": "error",
    "no-unused-expressions": "error",
    "preserve-caught-error": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    // With verbatimModuleSyntax, `import { type X }` keeps a bare runtime import; `import type` drops it.
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        // node:test registers these calls itself; their promises are not floating.
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "it", "describe", "suite", "before", "after", "beforeEach", "afterEach"]
          }
        ]
      }
    ],
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error"
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/*.test.*", "**/test-utils/**"],
      "globals": {
        "vi": "readonly",
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly"
      },
      "rules": { "no-console": "off" }
    },
    {
      // Command-line entry points, build and maintenance scripts write to the console by design.
      "files": ["**/bin/**", "**/scripts/**", "**/tools/**", "**/build.mjs", "**/build.ts", "**/*.config.*"],
      "rules": { "no-console": "off" }
    },
    {
      // chrome-devtools still compiles with strict:false; these two rules need strictNullChecks
      // and report every file regardless of its code. Remove once the package turns strict on.
      "files": ["packages/octocode-chrome-devtools/**"],
      "rules": {
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        "typescript/no-useless-default-assignment": "off"
      }
    }
  ]
}
