// The one oxlint config for every workspace; each lint script runs
// `oxlint -c ../../.oxlintrc.json .`; `options` below holds the shared lint flags.
// Violations that predate a rule live in .oxlintrc.baseline.json, which may only shrink
// (skills-dev/octocode-dev/scripts/oxlint-baseline.mjs).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.baseline.json"],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/out/**",
    "**/coverage/**",
    "**/*.d.ts",
    "**/*.d.mts",
    "**/*.generated.*",
    // esbuild output of skills/common/bundle-skill.mjs: a skill's src/keys.mjs with @octocodeai/config
    // bundled in; both sources are linted.
    "skills/*/scripts/keys.mjs",
    "**/fixtures/**",
    "**/examples/**",
    "packages/octocode-benchmark/local/repos/**",
    "packages/octocode-native/npm/**",
    "packages/octocode-native/target/**",
    ".octocode/**",
    ".claude/**"
  ],
  "rules": {
    // Off after reading a sample of each on 2026-11-05: 341 findings, no real bug. Casts at a checked
    // boundary, `.sort()` on a fresh array of strings, `require` destructuring, closures that read better in place.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/unbound-method": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/consistent-function-scoping": "off",
    // Backticks over string joins, and everyday best practices.
    "prefer-template": "error",
    "no-useless-concat": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-else-return": "error",
    "no-throw-literal": "error",
    "no-useless-return": "error",
    "no-lonely-if": "error",
    "yoda": "error",
    "no-console": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "prefer-const": "error",
    "no-var": "error",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-useless-escape": "error",
    "no-unused-expressions": "error",
    "preserve-caught-error": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    // With verbatimModuleSyntax, `import { type X }` keeps a bare runtime import; `import type` drops it.
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        // node:test registers these calls itself; their promises are not floating.
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "it", "describe", "suite", "before", "after", "beforeEach", "afterEach"]
          }
        ]
      }
    ],
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error"
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/*.test.*", "**/test-utils/**"],
      "globals": {
        "vi": "readonly",
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly"
      },
      "rules": { "no-console": "off" }
    },
    {
      // Command-line entry points, build and maintenance scripts write to the console by design.
      "files": ["**/bin/**", "**/scripts/**", "**/tools/**", "**/build.mjs", "**/build.ts", "**/*.config.*", "skills/*/src/**", "skills/common/bundle-skill.mjs"],
      "rules": { "no-console": "off" }
    },
    {
      // Data-format field names, not private members: corpus rows record their extract file in `_file`,
      // and HAR 1.2 custom fields (Chrome's `_resourceType`, `_failed`) start with an underscore.
      "files": ["skills/octocode-scraping/scripts/**"],
      "rules": { "no-underscore-dangle": ["error", { "allow": ["_file", "_resourceType", "_failed"] }] }
    }
  ]
}
