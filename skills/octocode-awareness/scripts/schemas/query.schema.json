{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "view": {
      "default": "all",
      "description": "Awareness read view.",
      "type": "string",
      "enum": [
        "all",
        "repo-profile",
        "memories",
        "gotchas",
        "lessons",
        "plans",
        "tasks",
        "runs",
        "locks",
        "agents",
        "signals",
        "refinements",
        "files",
        "activity",
        "workboard",
        "developer-review"
      ]
    },
    "query": {
      "default": "",
      "description": "Text filter.",
      "type": "string",
      "maxLength": 1000
    },
    "limit": {
      "default": 50,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "format": {
      "default": "json",
      "description": "Output format.",
      "type": "string",
      "enum": [
        "json",
        "table",
        "csv",
        "markdown",
        "html"
      ]
    },
    "out": {
      "description": "Optional output path.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "workspace_path": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "description": "Repo filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "description": "Ref filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_id": {
      "description": "Agent filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state": {
      "default": [],
      "description": "State/status filters.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "label": {
      "default": [],
      "description": "Memory label filters.",
      "maxItems": 32,
      "type": "array",
      "items": {
        "description": "Memory label.",
        "default": "OTHER",
        "type": "string",
        "enum": [
          "BUG",
          "FEATURE",
          "SUGGESTION",
          "GOTCHA",
          "IMPROVEMENT",
          "DECISION",
          "ARCHITECTURE",
          "SECURITY",
          "PERFORMANCE",
          "TEST",
          "BUILD",
          "DOCS",
          "CONFIG",
          "WORKFLOW",
          "REFACTOR",
          "API",
          "RELEASE",
          "INCIDENT",
          "EXPERIENCE",
          "OVERRIDE",
          "OTHER"
        ]
      }
    },
    "file": {
      "description": "File filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "since": {
      "description": "Created/updated since ISO.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "include_bodies": {
      "default": false,
      "description": "Include full signal bodies.",
      "type": "boolean"
    }
  },
  "required": [
    "view",
    "query",
    "limit",
    "format",
    "state",
    "label",
    "include_bodies"
  ],
  "additionalProperties": false,
  "description": "Query awareness views for agents, scripts, and humans.",
  "$id": "urn:octocode-awareness:schema:query",
  "examples": [
    {
      "view": "workboard",
      "query": "build",
      "limit": 10,
      "format": "json",
      "workspace_path": "/repo",
      "artifact": "pkg",
      "label": [
        "GOTCHA"
      ]
    }
  ]
}
