{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "archive",
        "restore"
      ],
      "description": "Lifecycle operation selected by the CLI noun/verb command."
    },
    "memory_id": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Explicit memory ids; lifecycle changes never use broad selectors."
    },
    "workspace_path": {
      "description": "Workspace scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "description": "Repo scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "description": "Ref scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dry_run": {
      "default": false,
      "description": "Preview selected ids without mutation.",
      "type": "boolean"
    }
  },
  "required": [
    "action",
    "memory_id",
    "dry_run"
  ],
  "additionalProperties": false,
  "description": "Reversibly archive memories or restore archived rows; replacement history cannot be restored.",
  "$id": "urn:octocode-awareness:schema:memory_lifecycle",
  "examples": [
    {
      "action": "archive",
      "memory_id": [
        "mem_abc123"
      ],
      "workspace_path": "/repo",
      "dry_run": true
    }
  ]
}
