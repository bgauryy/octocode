{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Agent id."
    },
    "task_context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Source task."
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Reusable lesson."
    },
    "importance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "1-10 importance."
    },
    "label": {
      "description": "Memory label.",
      "default": "OTHER",
      "type": "string",
      "enum": [
        "BUG",
        "FEATURE",
        "SUGGESTION",
        "GOTCHA",
        "IMPROVEMENT",
        "DECISION",
        "ARCHITECTURE",
        "SECURITY",
        "PERFORMANCE",
        "TEST",
        "BUILD",
        "DOCS",
        "CONFIG",
        "WORKFLOW",
        "REFACTOR",
        "API",
        "RELEASE",
        "INCIDENT",
        "EXPERIENCE",
        "OVERRIDE",
        "OTHER"
      ]
    },
    "tags": {
      "default": [],
      "description": "Filter tags.",
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9_.:-]+$"
      }
    },
    "references": {
      "default": [],
      "description": "Provenance refs, e.g. file:/abs/path, pr:owner/repo#1, URL.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "workspace_path": {
      "description": "Memory scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "description": "Repo scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "description": "Ref scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "file": {
      "description": "Primary file.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "file_tree_fingerprint": {
      "description": "Workspace hash.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "supersedes": {
      "default": [],
      "description": "Memory ids replaced.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "failure_signature": {
      "description": "Failure cluster key.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "valid_from": {
      "description": "Valid from ISO.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "valid_to": {
      "description": "Valid until ISO.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "allow_similar": {
      "default": false,
      "description": "Keep a materially distinct recurrence despite the duplicate gate.",
      "type": "boolean"
    }
  },
  "required": [
    "agent_id",
    "task_context",
    "observation",
    "importance",
    "label",
    "tags",
    "references",
    "supersedes",
    "allow_similar"
  ],
  "additionalProperties": false,
  "description": "Record a memory.",
  "$id": "urn:octocode-awareness:schema:tell_memory",
  "examples": [
    {
      "agent_id": "agent",
      "task_context": "task",
      "observation": "lesson",
      "importance": 8,
      "label": "GOTCHA",
      "tags": [
        "tag"
      ],
      "references": [
        "file:src/file.ts"
      ],
      "workspace_path": "/repo",
      "artifact": "pkg",
      "repo": "repo",
      "ref": "main",
      "file": "src/file.ts",
      "file_tree_fingerprint": "git:HEAD",
      "failure_signature": "sig"
    }
  ]
}
