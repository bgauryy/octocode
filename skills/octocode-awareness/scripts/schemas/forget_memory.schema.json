{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "memory_id": {
      "default": [],
      "description": "Memory ids.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "tags": {
      "default": [],
      "description": "Filter tags.",
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9_.:-]+$"
      }
    },
    "before": {
      "description": "Before ISO.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "max_importance": {
      "description": "Importance ceiling.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "workspace_path": {
      "description": "Workspace scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "description": "Repo scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "description": "Ref scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dry_run": {
      "default": false,
      "description": "Preview only.",
      "type": "boolean"
    }
  },
  "required": [
    "memory_id",
    "tags",
    "dry_run"
  ],
  "additionalProperties": false,
  "description": "Forget memories.",
  "$id": "urn:octocode-awareness:schema:forget_memory",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "tags": [
        "tag"
      ],
      "workspace_path": "/repo",
      "max_importance": 3,
      "dry_run": true
    }
  ]
}
