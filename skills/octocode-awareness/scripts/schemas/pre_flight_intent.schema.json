{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Agent id."
    },
    "workspace": {
      "description": "Workspace scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "run_id": {
      "description": "Existing claimed run to attach locks to.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "context_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Why edit."
    },
    "target_files": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "description": "Files to lock."
    },
    "test_plan": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Verification plan."
    },
    "wait_seconds": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "retry_interval": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "ttl_minutes": {
      "default": 10,
      "description": "Lock TTL minutes.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "ttl_seconds": {
      "description": "Lock TTL seconds; overrides ttl_minutes when provided.",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "required": [
    "agent_id",
    "rationale",
    "target_files",
    "test_plan",
    "wait_seconds",
    "retry_interval",
    "ttl_minutes"
  ],
  "additionalProperties": false,
  "description": "Acquire exclusive protection for sensitive files.",
  "$id": "urn:octocode-awareness:schema:pre_flight_intent",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "agent_id": "agent",
      "workspace": "/repo",
      "artifact": "pkg",
      "context_ref": "docs/decision.md",
      "rationale": "edit",
      "target_files": [
        "src/file.ts",
        "src/file.test.ts"
      ],
      "test_plan": "test passed",
      "retry_interval": 5,
      "ttl_seconds": 600
    }
  ]
}
