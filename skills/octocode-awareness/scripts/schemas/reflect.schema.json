{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Agent id."
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Task summary."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "worked",
        "partial",
        "failed"
      ],
      "description": "Outcome."
    },
    "worked": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "What worked."
    },
    "didnt_work": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "What didn't work."
    },
    "judgment_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Evidence/uncertainty note."
    },
    "lesson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Reusable lesson."
    },
    "failure_signature": {
      "description": "Failure cluster key.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eval_failures": {
      "default": [],
      "description": "Eval failures.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Eval id."
          },
          "dimension": {
            "description": "Eval dimension.",
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "failure_signature": {
            "description": "Failure cluster key.",
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "suggested_lesson": {
            "description": "Eval lesson.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "fix_repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Repo fix note."
    },
    "fix_file": {
      "default": [],
      "description": "Related files.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "fix_harness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Harness fix note."
    },
    "fix_instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Developer instructions feedback."
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "importance": {
      "description": "Importance override.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "duo": {
      "description": "Advisory duo packet.",
      "type": "boolean"
    },
    "allow_similar": {
      "default": false,
      "description": "Keep a materially distinct recurrence despite the duplicate gate.",
      "type": "boolean"
    }
  },
  "required": [
    "agent_id",
    "task",
    "outcome",
    "eval_failures",
    "fix_file",
    "allow_similar"
  ],
  "additionalProperties": false,
  "description": "Reflect after work.",
  "$id": "urn:octocode-awareness:schema:reflect",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "agent_id": "agent",
      "task": "task",
      "outcome": "partial",
      "worked": "worked",
      "didnt_work": "blocked",
      "judgment_note": "evidence",
      "lesson": "lesson",
      "fix_repo": "fix",
      "fix_file": [
        "src/file.ts"
      ],
      "fix_instructions": "clarify when agents should install hooks",
      "eval_failures": [
        {
          "id": "eval-1",
          "dimension": "planning",
          "failure_signature": "sig",
          "suggested_lesson": "lesson"
        }
      ],
      "duo": true
    }
  ]
}
