{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "refinement_id": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "description": "Refinement ids."
    },
    "dry_run": {
      "default": false,
      "description": "Preview only.",
      "type": "boolean"
    }
  },
  "required": [
    "refinement_id",
    "dry_run"
  ],
  "additionalProperties": false,
  "description": "Delete refinements.",
  "$id": "urn:octocode-awareness:schema:refine_delete",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "refinement_id": [
        "ref_abc123"
      ],
      "dry_run": true
    }
  ]
}
