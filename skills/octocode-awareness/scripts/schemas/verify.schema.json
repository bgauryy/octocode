{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Agent id."
    },
    "workspace": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "run_id": {
      "default": [],
      "description": "Run ids.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "all_pending": {
      "default": false,
      "description": "All pending runs.",
      "type": "boolean"
    },
    "status": {
      "default": "SUCCESS",
      "description": "Verification status.",
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED"
      ]
    },
    "message": {
      "description": "Verification note.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "agent_id",
    "run_id",
    "all_pending",
    "status"
  ],
  "additionalProperties": false,
  "description": "Mark verified.",
  "$id": "urn:octocode-awareness:schema:verify",
  "examples": [
    {
      "agent_id": "agent",
      "workspace": "/repo",
      "artifact": "pkg",
      "run_id": [
        "run_abc123"
      ],
      "all_pending": false,
      "status": "SUCCESS",
      "message": "test passed"
    }
  ]
}
