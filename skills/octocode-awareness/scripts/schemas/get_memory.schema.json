{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "default": "",
      "description": "Recall query.",
      "type": "string",
      "maxLength": 1000
    },
    "limit": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "min_importance": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "labels": {
      "default": [],
      "description": "Labels.",
      "maxItems": 32,
      "type": "array",
      "items": {
        "description": "Memory label.",
        "default": "OTHER",
        "type": "string",
        "enum": [
          "BUG",
          "FEATURE",
          "SUGGESTION",
          "GOTCHA",
          "IMPROVEMENT",
          "DECISION",
          "ARCHITECTURE",
          "SECURITY",
          "PERFORMANCE",
          "TEST",
          "BUILD",
          "DOCS",
          "CONFIG",
          "WORKFLOW",
          "REFACTOR",
          "API",
          "RELEASE",
          "INCIDENT",
          "EXPERIENCE",
          "OVERRIDE",
          "OTHER"
        ]
      }
    },
    "tags": {
      "default": [],
      "description": "Filter tags.",
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z0-9_.:-]+$"
      }
    },
    "files": {
      "default": [],
      "description": "Exact file refs.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "file_regex": {
      "default": [],
      "description": "File regex filters.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "regex": {
      "default": [],
      "description": "Text regex filters.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "references": {
      "default": [],
      "description": "Exact refs; all must match.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "workspace_path": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "description": "Repo filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "description": "Ref filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "strict_scope": {
      "default": false,
      "description": "Exact scope only.",
      "type": "boolean"
    },
    "global_only": {
      "default": false,
      "description": "Only unscoped rows.",
      "type": "boolean"
    },
    "sort": {
      "default": "smart",
      "description": "Sort order.",
      "type": "string",
      "enum": [
        "smart",
        "score",
        "importance",
        "recent",
        "accessed"
      ]
    },
    "smart": {
      "default": false,
      "description": "Broaden recall.",
      "type": "boolean"
    },
    "states": {
      "default": [
        "ACTIVE"
      ],
      "description": "Memory states.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUPERSEDED"
        ]
      }
    },
    "explain": {
      "default": false,
      "description": "Include score parts.",
      "type": "boolean"
    },
    "semantic": {
      "default": false,
      "description": "Request semantic recall.",
      "type": "boolean"
    },
    "full": {
      "default": false,
      "description": "Return full MemoryRecord rows (default is lean projection).",
      "type": "boolean"
    },
    "as_of": {
      "description": "Point-in-time ISO.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "query",
    "limit",
    "min_importance",
    "labels",
    "tags",
    "files",
    "file_regex",
    "regex",
    "references",
    "strict_scope",
    "global_only",
    "sort",
    "smart",
    "states",
    "explain",
    "semantic",
    "full"
  ],
  "additionalProperties": false,
  "description": "Recall memories.",
  "$id": "urn:octocode-awareness:schema:get_memory",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "query": "task",
      "limit": 3,
      "min_importance": 4,
      "labels": [
        "GOTCHA"
      ],
      "tags": [
        "tag"
      ],
      "references": [
        "file:src/file.ts"
      ],
      "workspace_path": "/repo",
      "artifact": "pkg",
      "repo": "repo",
      "strict_scope": false,
      "sort": "smart",
      "smart": true
    }
  ]
}
