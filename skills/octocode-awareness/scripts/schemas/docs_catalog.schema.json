{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "default": "list",
      "type": "string",
      "enum": [
        "list",
        "show"
      ]
    },
    "name": {
      "description": "Skill-ref name for docs show.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "full": {
      "default": false,
      "description": "Include abs path/root on docs list.",
      "type": "boolean"
    }
  },
  "required": [
    "action",
    "full"
  ],
  "additionalProperties": false,
  "description": "List or show skill reference docs.",
  "$id": "urn:octocode-awareness:schema:docs_catalog",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "action": "list"
    }
  ]
}
