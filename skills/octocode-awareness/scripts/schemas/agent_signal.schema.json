{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "publish",
        "list",
        "reply",
        "resolve",
        "ack"
      ],
      "description": "Action."
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Actor."
    },
    "workspace_path": {
      "description": "Workspace channel.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "description": "Signal kind.",
      "type": "string",
      "enum": [
        "claim",
        "handoff",
        "question",
        "reply",
        "blocker",
        "request",
        "decision",
        "fyi"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Subject."
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Body."
    },
    "to_agents": {
      "default": [],
      "description": "Recipients.",
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Agent id."
      }
    },
    "files": {
      "default": [],
      "description": "Related files.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "refs": {
      "default": [],
      "description": "Related ids.",
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "importance": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "1-10 importance."
    },
    "in_reply_to": {
      "description": "Reply target.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "thread_id": {
      "description": "Thread id.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signal_id": {
      "default": [],
      "description": "Signal ids.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "unread_only": {
      "default": true,
      "type": "boolean"
    },
    "mark_read": {
      "default": false,
      "type": "boolean"
    },
    "kinds": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claim",
          "handoff",
          "question",
          "reply",
          "blocker",
          "request",
          "decision",
          "fyi"
        ]
      }
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "include_bodies": {
      "default": false,
      "description": "Include full signal bodies on list (default summarizes to 160 chars).",
      "type": "boolean"
    },
    "format": {
      "default": "json",
      "description": "list only: json rows, or hook briefing shape for host notify delivery.",
      "type": "string",
      "enum": [
        "json",
        "hook"
      ]
    }
  },
  "required": [
    "action",
    "agent_id",
    "to_agents",
    "files",
    "refs",
    "importance",
    "signal_id",
    "unread_only",
    "mark_read",
    "kinds",
    "limit",
    "include_bodies",
    "format"
  ],
  "additionalProperties": false,
  "description": "Signal actions.",
  "$id": "urn:octocode-awareness:schema:agent_signal",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "action": "publish",
      "agent_id": "agent-a",
      "to_agents": [
        "agent-b"
      ],
      "kind": "question",
      "subject": "question",
      "body": "body",
      "files": [
        "src/file.ts"
      ],
      "artifact": "pkg",
      "refs": [
        "task_123"
      ],
      "importance": 7
    }
  ]
}
