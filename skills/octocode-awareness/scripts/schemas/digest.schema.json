{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "retention_days": {
      "default": 90,
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "refinement_handoff_retention_days": {
      "default": 7,
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "refinement_done_retention_days": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "operational_retention_days": {
      "default": 90,
      "description": "Compact old terminal standalone WORK/HOOK rows; receipts remain.",
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "pressure_age_days": {
      "default": 1,
      "description": "Report old pending runs/signals/missing refs without mutating them.",
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "dry_run": {
      "default": false,
      "type": "boolean"
    },
    "export_doc": {
      "description": "Write report.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      ]
    },
    "workspace": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    }
  },
  "required": [
    "retention_days",
    "refinement_handoff_retention_days",
    "refinement_done_retention_days",
    "operational_retention_days",
    "pressure_age_days",
    "dry_run"
  ],
  "additionalProperties": false,
  "description": "Prune/archive/reindex.",
  "$id": "urn:octocode-awareness:schema:digest",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "retention_days": 90,
      "refinement_handoff_retention_days": 7,
      "refinement_done_retention_days": 30,
      "operational_retention_days": 90,
      "dry_run": true,
      "workspace": "/repo",
      "artifact": "pkg"
    }
  ]
}
