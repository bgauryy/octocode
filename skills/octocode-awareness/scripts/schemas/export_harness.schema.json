{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "min_importance": {
      "default": 7,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "workspace": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    }
  },
  "required": [
    "limit",
    "min_importance"
  ],
  "additionalProperties": false,
  "description": "Export AGENTS block.",
  "$id": "urn:octocode-awareness:schema:export_harness",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "limit": 10,
      "min_importance": 7,
      "workspace": "/repo",
      "artifact": "pkg"
    }
  ]
}
