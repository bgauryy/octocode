{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "description": "Workspace filter.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Artifact/package scope."
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Repo slug."
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Branch/tag/SHA."
    },
    "state": {
      "description": "Filter by refinement state: open|ongoing|done.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "limit": {
      "default": 60,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "format": {
      "default": "json",
      "description": "json rows or the markdown digest.",
      "type": "string",
      "enum": [
        "json",
        "markdown"
      ]
    },
    "query": {
      "description": "Text filter over feedback.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "limit",
    "format"
  ],
  "additionalProperties": false,
  "description": "Read agent feedback to the instruction author (from reflect record --fix-instructions).",
  "$id": "urn:octocode-awareness:schema:developer_review",
  "$comment": "Generated by packages/octocode-awareness/build.mjs — do not edit by hand.",
  "examples": [
    {
      "workspace": "/repo",
      "format": "markdown"
    }
  ]
}
