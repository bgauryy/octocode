{
  "schemaVersion": 1,
  "description": "Smoke evals for octocode-prompt-optimizer answers. Deterministic floor; held-out behavior still needs graph-eval.",
  "rubric": [
    "Rates issues with severity before rewriting.",
    "Preserves intent; names deferrals.",
    "Validates required behavior remains.",
    "Reports a truthful delta / change report.",
    "Does not silently mutate authority without asking."
  ],
  "cases": [
    {
      "id": "tighten-prompt",
      "mode": "optimize",
      "prompt": "This system prompt is vague and burns context — make it clearer and cheaper.",
      "minScore": 0.8,
      "required": [
        { "name": "rate or issues", "pattern": "\\bRate\\b|\\bCritical\\b|\\bHigh\\b|\\bissue" },
        { "name": "intent preserved", "pattern": "\\bintent\\b|\\bpreserv|\\bunchanged goal\\b" },
        { "name": "validate", "pattern": "\\bValidat|\\bstill (?:does|requires|enforces)\\b|\\brequired behavior\\b" },
        { "name": "delta", "pattern": "\\bDelta\\b|\\bChanged\\b|\\bBefore\\b[\\s\\S]{0,40}\\bAfter\\b|\\brewrite\\b" }
      ]
    },
    {
      "id": "tool-schema",
      "mode": "optimize",
      "prompt": "Harden this tool schema so agents stop omitting required fields.",
      "minScore": 0.8,
      "required": [
        { "name": "schema or contract", "pattern": "\\bschema\\b|\\brequired\\b|\\bcontract\\b|\\bZod\\b|\\bproperties\\b" },
        { "name": "rate", "pattern": "\\bRate\\b|\\bCritical\\b|\\bHigh\\b|\\bfailure\\b" },
        { "name": "validate", "pattern": "\\bValidat|\\bstill\\b|\\bintent\\b" },
        { "name": "delta", "pattern": "\\bDelta\\b|\\bChanged\\b|\\brewrite\\b|\\bbefore\\b|\\bafter\\b" }
      ]
    }
  ]
}
