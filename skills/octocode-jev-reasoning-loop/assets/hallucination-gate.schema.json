{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hallucination-gate",
  "title": "Jev Hallucination Gate Request",
  "description": "Small public Jev packet for semantically checking one assertion against explicit grounding evidence.",
  "$comment": "Code blocks empty evidence and deterministically incompatible scope before this route. Jev is used only for semantic grounding.",
  "type": "object",
  "required": ["model", "state", "questions"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "state": {
      "type": "object",
      "description": "VISIBILITY BOUNDARY: one claim and the minimal evidence intended to ground it.",
      "required": ["goal", "reasoning", "claim", "evidence"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "reasoning": { "$ref": "#/$defs/ReasoningSummary" },
        "claim": { "type": "string", "minLength": 5 },
        "claim_scope": { "type": "string" },
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "source", "scope", "content"],
            "properties": {
              "id": { "type": "string", "pattern": "^E[0-9]+$" },
              "source": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "content": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "known_gaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "object",
      "required": ["grounded", "evidence_anchor"],
      "properties": {
        "grounded": { "$ref": "#/$defs/Noul" },
        "evidence_anchor": { "$ref": "#/$defs/Choice" },
        "scope_matches": { "$ref": "#/$defs/Noul" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ReasoningSummary": {
      "type": "object",
      "description": "Bounded, auditable decision summary for agentic use; never hidden chain-of-thought or private scratch.",
      "required": ["observations", "uncertainty"],
      "properties": {
        "observations": { "type": "string", "minLength": 1 },
        "inferences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "strongest_counter": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string", "minLength": 1 },
        "prediction": { "type": "string", "minLength": 1 },
        "falsifier": { "type": "string", "minLength": 1 },
        "discriminating_observation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Choice": {
      "type": "object", "required": ["type", "instructions", "criteria"],
      "properties": {
        "type": { "const": "choice" },
        "instructions": { "type": "string", "minLength": 1 },
        "criteria": { "type": "object", "minProperties": 2, "patternProperties": { "^E[0-9]+$": { "type": "string" }, "^none$": { "type": "string" } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "Noul": {
      "type": "object", "required": ["type", "instructions", "criteria"],
      "properties": { "type": { "const": "noul" }, "instructions": { "type": "string", "minLength": 1 }, "criteria": { "type": "object", "required": ["true", "false"] } },
      "additionalProperties": false
    }
  }
}
