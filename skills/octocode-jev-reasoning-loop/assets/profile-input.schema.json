{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Jev typed source profile input",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "inputs",
  "aspects"
 ],
 "properties": {
  "goal": {
   "type": "string",
   "minLength": 1,
   "maxLength": 800
  },
  "root": {
   "type": "string",
   "minLength": 1,
   "maxLength": 1000
  },
  "model": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "maxChars": {
   "type": "integer",
   "minimum": 1,
   "maximum": 48000,
   "default": 24000
  },
  "inputs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "path"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       },
       "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
       },
       "lines": {
        "type": "string",
        "pattern": "^[1-9]\\d*(?:-[1-9]\\d*)?$"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "content"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       },
       "content": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48000
       },
       "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
       }
      }
     }
    ],
    "properties": {
     "maxChars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48000,
      "description": "Per-source override of the top-level maxChars."
     }
    }
   }
  },
  "aspects": {
   "type": "array",
   "minItems": 1,
   "maxItems": 24,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "type",
       "instructions",
       "criteria"
      ],
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
       },
       "type": {
        "const": "score"
       },
       "instructions": {},
       "criteria": {
        "type": "array",
        "minItems": 2,
        "maxItems": 10
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "type",
       "instructions"
      ],
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
       },
       "type": {
        "const": "noul"
       },
       "instructions": {},
       "criteria": {
        "type": [
         "object",
         "null"
        ]
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "type",
       "instructions",
       "criteria"
      ],
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
       },
       "type": {
        "const": "choice"
       },
       "instructions": {},
       "criteria": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 255
       }
      }
     }
    ]
   }
  }
 }
}
