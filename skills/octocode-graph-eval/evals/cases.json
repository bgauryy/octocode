{
  "schemaVersion": 1,
  "description": "Machine-checkable smoke evals for octocode-graph-eval answers. Deterministic floor only; human review still judges evidence quality.",
  "rubric": [
    "Links every KPI to a parent goal (cascade).",
    "Declares measurable primary with baseline/target and decision rule.",
    "Keeps the eval harness frozen; never edits cases to pass.",
    "Uses keep/discard or ACCEPT/REVERT with checks run.",
    "Mentions held-out or guardrails when accepting a change.",
    "Chooses graders thoughtfully; knows public vs private benches.",
    "Picks the right nested loop; grows suites from error analysis."
  ],
  "cases": [
    {
      "id": "define-kpi",
      "mode": "Define",
      "prompt": "Define a KPI contract before changing a skill description.",
      "minScore": 0.85,
      "required": [
        { "name": "mode define", "pattern": "\\bMode:\\s*Define\\b|\\bDefine\\b[\\s\\S]{0,40}\\bKPI\\b" },
        { "name": "goal", "pattern": "\\bGoal:|#{1,3}\\s*Goal\\b" },
        { "name": "primary KPI", "pattern": "\\bPrimary KPI\\b|\\bprimary\\b[\\s\\S]{0,80}\\b(baseline|target)\\b" },
        { "name": "baseline and target", "pattern": "\\bbaseline\\b[\\s\\S]{0,80}\\btarget\\b" },
        { "name": "guardrails", "pattern": "\\bGuardrails?:|#{1,3}\\s*Guardrails?\\b" },
        { "name": "held-out", "pattern": "\\bHeld-out\\b|\\bheld-out\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "measurable-primary",
          "dimension": "kpi",
          "question": "Is the primary KPI measurable with baseline and target?",
          "passPattern": "\\b(baseline|target)\\b[\\s\\S]{0,120}\\b(baseline|target)\\b",
          "failureSignature": "mechanism:eval-kpi|cause:unmeasurable-primary",
          "suggestedLesson": "Write baseline and target numbers before mutating the subject."
        }
      ],
      "forbidden": [
        { "name": "feels better KPI", "pattern": "\\bKPI\\b[^\\n]{0,12}\\bfeels better\\b" }
      ]
    },
    {
      "id": "link-goal-kpi",
      "mode": "Define",
      "prompt": "Cascade a user goal into leading and lagging KPIs with a decision rule.",
      "minScore": 0.85,
      "required": [
        { "name": "goal", "pattern": "\\bGoal:|#{1,3}\\s*Goal\\b" },
        { "name": "lagging or primary", "pattern": "\\blagging\\b|\\bPrimary KPI\\b|\\bprimary\\b" },
        { "name": "leading", "pattern": "\\b[Ll]eading\\b" },
        { "name": "guardrails", "pattern": "\\bGuardrails?:|#{1,3}\\s*Guardrails?\\b" },
        { "name": "decision rule", "pattern": "\\bDecision\\b|\\bACCEPT if\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "kpi-serves-goal",
          "dimension": "cascade",
          "question": "Does the answer tie the primary KPI back to the goal?",
          "passPattern": "\\bserves? (the )?goal\\b|\\bparent goal\\b|\\bGoal:[\\s\\S]{0,400}\\b(Primary|primary|lagging)",
          "failureSignature": "mechanism:eval-kpi|cause:orphan-metric",
          "suggestedLesson": "Every KPI must name the parent goal it serves."
        }
      ],
      "forbidden": [
        { "name": "orphan vanity metric", "pattern": "\\boptimize tokens\\b[\\s\\S]{0,80}\\bwithout\\b[\\s\\S]{0,40}\\bgoal\\b" }
      ]
    },
    {
      "id": "run-keep-discard",
      "mode": "Run",
      "prompt": "Run a keep/discard improvement loop and report.",
      "minScore": 0.85,
      "required": [
        { "name": "goal section", "pattern": "#{1,3}\\s*Goal\\b|\\bGoal:" },
        { "name": "KPI with baseline result", "pattern": "\\bprimary\\b[\\s\\S]{0,160}\\bbaseline\\b[\\s\\S]{0,160}\\bresult\\b" },
        { "name": "checks run", "pattern": "#{1,3}\\s*Checks run\\b|\\bChecks run\\b" },
        { "name": "harness frozen", "pattern": "\\bHarness unchanged\\b|\\bharness\\b[\\s\\S]{0,40}\\bunchanged\\b" },
        { "name": "verdict", "pattern": "\\bVerdict\\b[\\s\\S]{0,40}\\b(ACCEPT|REVERT|CONTINUE|KEEP|DISCARD)\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "keep-or-discard",
          "dimension": "loop",
          "question": "Does the report end in ACCEPT, REVERT, or CONTINUE with measured result?",
          "passPattern": "\\b(ACCEPT|REVERT|CONTINUE)\\b[\\s\\S]{0,200}\\b(result|baseline|score|exit)\\b|\\b(result|baseline|score|exit)\\b[\\s\\S]{0,200}\\b(ACCEPT|REVERT|CONTINUE)\\b",
          "failureSignature": "mechanism:eval-loop|cause:no-keep-discard",
          "suggestedLesson": "Close every loop with measured result and ACCEPT/REVERT/CONTINUE."
        }
      ],
      "forbidden": [
        { "name": "edit cases to pass", "pattern": "(?<!\\bnot )(?<!\\bnever )\\bedited (the )?(eval|cases|grader)[^\\n.]{0,60}\\bpass\\b" }
      ]
    },
    {
      "id": "nested-loops-pick",
      "mode": "Run",
      "prompt": "Primary metric is flat after many keep/discard trials. Which loop next?",
      "minScore": 0.8,
      "required": [
        { "name": "names experiment loop", "pattern": "\\bexperiment\\b" },
        { "name": "names suite or meta", "pattern": "\\bsuite\\b|\\bmeta\\b|\\bharness\\b" },
        { "name": "escalate", "pattern": "\\bescalat|\\bsuite loop\\b|\\berror analys|\\bfailure (mode|taxonom)" }
      ],
      "binaryQuestions": [
        {
          "id": "no-harness-cheat",
          "dimension": "loop",
          "question": "Does the answer refuse to edit graders just to pass the flat experiment?",
          "passPattern": "\\bnot (edit|change) (the )?(grader|cases|harness).*pass\\b|\\bfrozen harness\\b|\\bnever.*greenwash\\b|\\bdo not edit.*grader",
          "failureSignature": "mechanism:eval-loop|cause:escalate-by-cheating",
          "suggestedLesson": "When flat, escalate to suite/meta — never edit graders to pass."
        }
      ],
      "forbidden": [
        { "name": "edit graders to pass", "pattern": "(?<!\\bnot )(?<!\\bnever )\\bedit( the)? (grader|cases) to (make it )?pass\\b" }
      ]
    },
    {
      "id": "choose-graders",
      "mode": "Suite",
      "prompt": "Choose graders for an agent coding task.",
      "minScore": 0.8,
      "required": [
        { "name": "deterministic first", "pattern": "\\bdeterministic\\b" },
        { "name": "capability or regression", "pattern": "\\bcapability\\b|\\bregression\\b" },
        { "name": "outcome over path", "pattern": "\\boutcome\\b|\\bpath\\b|\\btool-call\\b" },
        { "name": "fail-to-pass or pass-to-pass", "pattern": "\\bfail-to-pass\\b|\\bpass-to-pass\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "mentions-binary-or-llm",
          "dimension": "graders",
          "question": "Does the plan mention binary questions or LLM rubric as secondary layers?",
          "passPattern": "\\bbinary\\b|\\bBinEval\\b|\\bLLM\\b|\\brubric\\b",
          "failureSignature": "mechanism:eval-graders|cause:no-secondary-layer",
          "suggestedLesson": "Stack deterministic floors with binary/LLM layers when nuance is needed."
        }
      ],
      "forbidden": [
        { "name": "path-only grading", "pattern": "\\bmust follow exact tool order\\b|(?<!\\bnot )(?<!\\bnever )\\bonly grade the path\\b" }
      ]
    },
    {
      "id": "pick-benchmark",
      "mode": "Benchmark",
      "prompt": "Should we gate a ship on SWE-bench Verified alone?",
      "minScore": 0.85,
      "required": [
        { "name": "private suite", "pattern": "\\bprivate (suite|eval|cases)\\b|\\bown failures\\b|\\breal failures\\b" },
        { "name": "contamination or saturation", "pattern": "\\bcontaminat|\\bsaturat|\\bleakage\\b|\\bbenchmaxx" },
        { "name": "orientation not sole gate", "pattern": "\\borient|\\bnot (a |the )?sole\\b|\\bweak\\b|\\bnot.*ship gate\\b|\\bdo not gate\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "prefers-private-gate",
          "dimension": "benchmark",
          "question": "Does the answer prefer a private failure-derived suite as the ship gate?",
          "passPattern": "\\bprivate\\b[\\s\\S]{0,80}\\b(gate|ship|ACCEPT|primary)\\b|\\b(gate|ship|ACCEPT|primary)\\b[\\s\\S]{0,80}\\bprivate\\b",
          "failureSignature": "mechanism:eval-bench|cause:public-only-gate",
          "suggestedLesson": "Public benches orient; private failure suites gate ships."
        }
      ],
      "forbidden": [
        { "name": "sole public gate", "pattern": "\\bSWE-bench (Verified )?is (our |the )?(sole|only) (proof|gate|ship gate)\\b|(?<!\\bnot )(?<!n't )\\bonly (need|use) SWE-bench\\b" }
      ]
    },
    {
      "id": "error-analyze",
      "mode": "ErrorAnalyze",
      "prompt": "Build an eval suite for a flaky research agent. Where do cases come from?",
      "minScore": 0.85,
      "required": [
        { "name": "traces or dataset", "pattern": "\\btraces?\\b|\\bdataset\\b" },
        { "name": "open or axial coding", "pattern": "\\bopen coding\\b|\\baxial\\b|\\bfailure taxonom" },
        { "name": "failure modes", "pattern": "\\bfailure (mode|taxonom|signature)" }
      ],
      "binaryQuestions": [
        {
          "id": "not-generic-metrics",
          "dimension": "error-analysis",
          "question": "Does the answer avoid starting from generic vanity metrics?",
          "passPattern": "\\bnot (start|begin) from generic\\b|\\breal (failures|traces)\\b|\\bfrequency\\b|\\btaxonom",
          "failureSignature": "mechanism:eval-error-analysis|cause:generic-metrics-first",
          "suggestedLesson": "Write evals from a failure taxonomy, not generic platform metrics."
        }
      ],
      "forbidden": [
        { "name": "generic only", "pattern": "(?<!\\bnot )(?<!n't )\\bonly (use|need) (toxicity|helpfulness) scores\\b" }
      ]
    },
    {
      "id": "reject-vibe",
      "mode": "Audit",
      "prompt": "Audit a vibe-only improvement claim.",
      "minScore": 0.85,
      "required": [
        { "name": "revert", "pattern": "\\bREVERT\\b" },
        { "name": "calls out vibes or narrative", "pattern": "\\bvibes?\\b|\\bnarrative-only\\b|\\bfeels better\\b" },
        { "name": "harness freeze", "pattern": "\\bharness\\b|\\bcases\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "results-over-words",
          "dimension": "discipline",
          "question": "Does the audit insist results beat words?",
          "passPattern": "\\bresults beat words\\b|\\bno baseline\\b|\\bnarrative-only\\b",
          "failureSignature": "mechanism:eval-audit|cause:accepted-vibes",
          "suggestedLesson": "Reject narrative-only accepts; demand baseline KPI and frozen harness."
        }
      ],
      "forbidden": [
        { "name": "accept vibes", "pattern": "(?<!\\bnot )(?<!\\bnever )\\bACCEPT\\b[\\s\\S]{0,60}\\bfeels better\\b" }
      ]
    },
    {
      "id": "graph-eval",
      "mode": "Run",
      "prompt": "Our multi-agent pipeline's end-to-end quality dropped. Evaluate it and decide what to fix.",
      "minScore": 0.85,
      "required": [
        { "name": "end-to-end primary", "pattern": "\\bend-to-end\\b|\\bgraph boundary\\b|\\bgraph-level\\b" },
        { "name": "per-node sensors", "pattern": "\\bper-node\\b|\\bnode-level\\b|\\beach (node|agent|loop)\\b" },
        { "name": "attribution", "pattern": "\\bbisect\\b|\\battribut|\\bwhich node\\b|\\bfrozen inputs\\b" },
        { "name": "verdict", "pattern": "\\b(ACCEPT|REVERT|CONTINUE|KEEP|DISCARD)\\b" },
        { "name": "guardrails", "pattern": "\\bguardrail" }
      ],
      "binaryQuestions": [
        {
          "id": "verifier-before-nodes",
          "dimension": "graph",
          "question": "Does the answer strengthen sensors/verifiers before changing topology or adding nodes?",
          "passPattern": "\\bstrengthen[\\s\\S]{0,60}\\b(verifier|sensor)\\b|\\bbefore adding (a )?node\\b|\\bnot add (a )?node\\b",
          "failureSignature": "mechanism:eval-graph|cause:add-nodes-first",
          "suggestedLesson": "Strengthen per-node sensors before changing topology."
        }
      ],
      "forbidden": [
        { "name": "add agents as first fix", "pattern": "\\bjust add (more|another) agents?\\b" }
      ]
    },
    {
      "id": "loop-until-target",
      "mode": "Run",
      "prompt": "Get p95 latency under 300ms. Don't stop till you're done — use a profiler.",
      "minScore": 0.85,
      "required": [
        { "name": "sensor named", "pattern": "\\bprofil|\\bsensor\\b|\\bbenchmark\\b" },
        { "name": "numeric target", "pattern": "\\btarget\\b[\\s\\S]{0,60}\\d|\\b300\\s?ms\\b" },
        { "name": "budget declared", "pattern": "\\bbudget\\b|\\btrials\\b" },
        { "name": "keep or discard loop", "pattern": "\\b(KEEP|DISCARD|keep/discard|ACCEPT|REVERT)\\b" },
        { "name": "no mid-loop pause", "pattern": "\\bwithout paus|\\bdo(es)? not (pause|stop)\\b|\\bno paus" }
      ],
      "binaryQuestions": [
        {
          "id": "sensor-before-loop",
          "dimension": "loop",
          "question": "Does the answer verify a runnable sensor and target before the first mutation?",
          "passPattern": "\\b(sensor|profiler|benchmark|baseline)\\b[\\s\\S]{0,120}\\bbefore (the )?first (mutation|change|iteration)\\b|\\bbefore (mutating|iterating|the loop)\\b",
          "failureSignature": "mechanism:eval-loop|cause:loop-without-sensor",
          "suggestedLesson": "Verify a runnable sensor and numeric target before the first mutation."
        }
      ],
      "forbidden": [
        { "name": "vibes stop condition", "pattern": "\\bstop (when|once|if) (it )?(looks|feels) faster\\b" }
      ]
    },
    {
      "id": "trajectory-mode-selection",
      "mode": "Audit",
      "prompt": "Our customer support agent must always call a policy_lookup tool before calling a refund_tool. Both tools are called in every run. Which trajectory match mode should we use and why?",
      "minScore": 0.85,
      "required": [
        { "name": "strict mode chosen", "pattern": "\\bstrict\\b" },
        { "name": "ordering requirement stated", "pattern": "\\border(ing)?\\b|\\bsequence\\b|\\bbefore\\b|\\bprecede\\b|\\bpolicy.+before\\b" },
        { "name": "why ordering matters", "pattern": "\\bpolic(y|ies)\\b[\\s\\S]{0,80}\\b(before|first|prior)\\b|\\bbusiness rule\\b|\\brequirement\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "strict-when-ordering-required",
          "dimension": "trajectory",
          "question": "Does the answer choose strict mode AND explain that ordering is required because policy_lookup must precede refund_tool?",
          "passPattern": "\\bstrict\\b[\\s\\S]{0,200}\\border|\\border[\\s\\S]{0,200}\\bstrict\\b",
          "failureSignature": "mechanism:eval-trajectory|cause:wrong-match-mode",
          "suggestedLesson": "Default to unordered; use strict only when you can articulate why sequence matters. Policy enforcement (step A before step B) is the canonical strict-mode use case."
        }
      ],
      "forbidden": [
        { "name": "wrong mode chosen", "pattern": "\\b(unordered|subset|superset)\\b[\\s\\S]{0,60}\\b(recommend|use|choose|select)\\b" }
      ]
    },
    {
      "id": "shared-context-verifier",
      "mode": "Audit",
      "prompt": "Our graph has a verifier agent that receives the full conversation history from the executor agent before grading. Is this a valid independent check?",
      "minScore": 0.85,
      "required": [
        { "name": "not independent", "pattern": "\\bnot independent\\b|\\bshared context\\b|\\bsame context\\b" },
        { "name": "fresh context required", "pattern": "\\bfresh (context|session|instance)\\b|\\bclean context\\b|\\bisolated context\\b" },
        { "name": "agreeing with itself", "pattern": "\\bagreeing\\b|\\bnodding\\b|\\bconfirms its own\\b|\\bself.confirm\\b|\\bgrade its own\\b" },
        { "name": "fix or reject", "pattern": "\\b(REVERT|fix|invalid|not valid|restructure|separate)\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "verifier-must-be-fresh",
          "dimension": "graph",
          "question": "Does the answer require the verifier to use fresh context rather than the executor's conversation history?",
          "passPattern": "\\bfresh (context|instance|session)\\b|\\bisolated\\b[\\s\\S]{0,80}\\bverif|\\bverif[\\s\\S]{0,80}\\bfresh\\b",
          "failureSignature": "mechanism:eval-graph|cause:shared-context-verifier",
          "suggestedLesson": "A verifier with the executor's context is not independent — it agrees in a different font. Require fresh context per verifier node."
        }
      ],
      "forbidden": [
        { "name": "accepts shared context verifier", "pattern": "(?<!\\bnot )(?<!\\bnever )\\bshared context\\b[\\s\\S]{0,60}\\bvalid (check|verif)\\b" }
      ]
    },
    {
      "id": "fake-parallelism",
      "mode": "Audit",
      "prompt": "Our workflow runs: fetch data, then summarize, then send report. We called it a graph and ran all three in parallel. Was that correct?",
      "minScore": 0.85,
      "required": [
        { "name": "edge detection", "pattern": "\\bedge\\b|\\bdependenc|\\breads? (the |prior |previous )?output\\b|\\breal (edge|dependenc)\\b" },
        { "name": "actual dependency check", "pattern": "\\bactually (reads?|uses?|needs?)\\b|\\bdoes (the )?next step\\b|\\bdata crossing\\b|\\bdata flow\\b" },
        { "name": "not a real graph or sequential required", "pattern": "\\bnot (a )?real graph\\b|\\bsequential\\b|\\bfake (graph|parallelism)\\b|\\bchain\\b|\\bgenuinely depend\\b" },
        { "name": "coordination cost", "pattern": "\\bcoordination (cost|overhead)\\b|\\bno speedup\\b|\\bno (width|parallel width)\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "real-vs-fake-edge",
          "dimension": "graph",
          "question": "Does the answer correctly identify that summarize depends on fetched data and report depends on summary — making these real sequential edges, not a parallel graph?",
          "passPattern": "\\bsequential\\b|\\breal edge\\b|\\bgenuinely depend\\b|\\bnot independent\\b|\\bcannot parallelize\\b",
          "failureSignature": "mechanism:eval-graph|cause:fake-parallelism",
          "suggestedLesson": "For every 'and then': does the next step actually read the previous output? If yes, it is a real edge. Forcing parallelism onto genuinely sequential steps adds coordination overhead for zero speedup."
        }
      ],
      "forbidden": [
        { "name": "approves fake parallel graph", "pattern": "(?<!\\bnot )(?<!\\bnever )\\b(correct|fine|ok|valid)\\b[\\s\\S]{0,80}\\bparallel\\b[\\s\\S]{0,80}\\b(fetch|summarize|report)\\b" }
      ]
    },
    {
      "id": "goodhart-detection",
      "mode": "Audit",
      "prompt": "Our support bot's ticket-resolution rate improved 30% over three months. But customer satisfaction scores dropped in the same period. The agent is still optimizing. What do we do?",
      "minScore": 0.85,
      "required": [
        { "name": "goodhart or metric mismatch", "pattern": "\\bGoodhart\\b|\\bwrong metric\\b|\\boptimizing the metric\\b|\\bmetric instead of the goal\\b|\\bproxy metric\\b" },
        { "name": "stop the loop", "pattern": "\\bstop\\b|\\bhalt\\b|\\bpause\\b|\\bREVERT\\b|\\bdo not continue\\b" },
        { "name": "reframe goal not loop", "pattern": "\\breframe\\b|\\bnew (goal|KPI|primary)\\b|\\bredefine\\b|\\bchange the metric\\b|\\bgoal is wrong\\b|\\bprimary is wrong\\b" },
        { "name": "counter-metric or guardrail", "pattern": "\\bcounter.metric\\b|\\bguardrail\\b|\\bsatisfaction\\b[\\s\\S]{0,60}\\b(guardrail|floor|minimum)\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "stop-dont-optimize",
          "dimension": "goodhart",
          "question": "Does the answer stop the optimization loop and reframe the goal rather than continuing to optimize the resolution rate?",
          "passPattern": "\\b(stop|halt|pause|REVERT)\\b[\\s\\S]{0,150}\\b(reframe|goal|KPI|primary|metric)\\b|\\b(reframe|goal|KPI|primary)\\b[\\s\\S]{0,150}\\b(stop|halt|pause|REVERT)\\b",
          "failureSignature": "mechanism:eval-goodhart|cause:optimize-wrong-metric",
          "suggestedLesson": "Primary improving while guardrail degrades means the primary is wrong. Stop and reframe the goal — Goodhart's Law. Every KPI must have a counter-metric the agent cannot tune."
        }
      ],
      "forbidden": [
        { "name": "keep optimizing resolution rate", "pattern": "(?<!\\bnot )(?<!\\bnever )\\b(continue|keep) optimizing\\b[\\s\\S]{0,60}\\b(resolution rate|ticket resolution)\\b" }
      ]
    },
    {
      "id": "bilevel-escalation",
      "mode": "Run",
      "prompt": "The improvement loop for our code generation agent has run 80 trials. The primary metric has been flat for the last 30 trials and error analysis finds no new failure mode categories. What do you do next?",
      "minScore": 0.85,
      "required": [
        { "name": "not more inner-loop trials", "pattern": "\\bnot (more|another) (trial|experiment|iteration)\\b|\\bdo not continue (the inner|inner loop)\\b|\\bflat\\b" },
        { "name": "stuck priors or search pattern", "pattern": "\\b(stuck|trapped)\\b[\\s\\S]{0,80}\\b(prior|pattern|search)\\b|\\bmodel prior\\b|\\bsearch pattern\\b|\\bsame hypothesis\\b" },
        { "name": "bilevel or meta or outer loop", "pattern": "\\bbilevel\\b|\\bmeta.loop\\b|\\bouter loop\\b|\\bloop on top\\b" },
        { "name": "rewrite search strategy", "pattern": "\\brewrite (the )?search\\b|\\bnew (strategy|search strategy|exploration)\\b|\\bhow the (inner )?loop searches\\b|\\bchange (how|the way) it searches\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "outer-loop-not-more-trials",
          "dimension": "bilevel",
          "question": "Does the answer escalate to a meta/outer loop that rewrites the search strategy, rather than running more inner-loop trials or simply editing program.md wording?",
          "passPattern": "\\bbilevel\\b|\\bouter loop\\b[\\s\\S]{0,150}\\b(search|strategy|rewrite)\\b|\\brewrite[\\s\\S]{0,80}\\b(search|strategy|how it)\\b",
          "failureSignature": "mechanism:eval-bilevel|cause:more-inner-trials-when-flat",
          "suggestedLesson": "When the inner loop is flat and error analysis has no new categories, the search strategy itself is stuck in model priors. Escalate to bilevel: an outer loop that reads the inner loop's trace and rewrites how it searches — not just what it searches for."
        }
      ],
      "forbidden": [
        { "name": "run more inner trials", "pattern": "(?<!\\bnot )(?<!\\bnever )\\brun (more|additional) (trials|experiments|iterations)\\b" }
      ]
    },
    {
      "id": "tdd-red-green",
      "mode": "Run",
      "prompt": "Run a TDD-style eval loop: failing case before the subject change.",
      "minScore": 0.85,
      "required": [
        { "name": "red or failing first", "pattern": "\\b[Rr]ed\\b|\\bfailing (case|check|test)\\b|\\bbaseline\\b" },
        { "name": "green or remmeasure", "pattern": "\\b[Gg]reen\\b|\\bre-?measur|\\bsame (command|harness)\\b" },
        { "name": "keep or discard", "pattern": "\\b(KEEP|DISCARD|ACCEPT|REVERT)\\b" },
        { "name": "harness frozen", "pattern": "\\bharness\\b[\\s\\S]{0,40}\\bunchanged\\b|\\bfrozen harness\\b|\\bHarness unchanged\\b" }
      ],
      "binaryQuestions": [
        {
          "id": "fail-before-fix",
          "dimension": "tdd",
          "question": "Does the answer require a failing check before mutating the subject?",
          "passPattern": "\\bbefore (mutating|changing|the (subject|patch))\\b|\\bfailing (case|check).{0,40}before\\b|\\b[Rr]ed\\b[\\s\\S]{0,80}\\b[Gg]reen\\b",
          "failureSignature": "mechanism:eval-tdd|cause:fix-before-fail",
          "suggestedLesson": "Write or select the failing case/KPI before editing the subject."
        }
      ],
      "forbidden": [
        { "name": "edit grader to pass", "pattern": "(?<!\\bnot )(?<!\\bnever )\\bedit(ed|ing)? (the )?(grader|cases) to pass\\b" }
      ]
