{
  "schemaVersion": 1,
  "description": "Smoke evals for octocode-documentation answers. Deterministic floor; human review still judges claim accuracy.",
  "rubric": [
    "Names mode (agent-docs / human-docs / adr / codebase-pack).",
    "Verifies claims before asserting; no invented commands/paths.",
    "Gates outline or write approval.",
    "Prefers durable cross-refs over pasted code dumps.",
    "Keeps one Diátaxis type per page when human-docs."
  ],
  "cases": [
    {
      "id": "agents-md-index",
      "mode": "agent-docs",
      "prompt": "Update AGENTS.md so agents can find the real build and test commands.",
      "minScore": 0.8,
      "required": [
        { "name": "mode", "pattern": "\\bMode:\\s*agent-docs\\b|\\bagent-docs\\b|\\bAGENTS\\.md\\b" },
        { "name": "outline or gate", "pattern": "\\bOutline\\b|\\boutline gate\\b|\\bapproved\\b|\\bWRITE\\b" },
        { "name": "verified claim", "pattern": "\\bverif(?:y|ied)\\b|\\bevidence\\b|\\bfrom (?:repo|package\\.json|README)\\b" },
        { "name": "no invent", "pattern": "\\bunverified\\b|\\bomit\\b|\\blink\\b|\\bpointer\\b|`[^`]+`" }
      ],
      "forbidden": [
        { "name": "pasted mega block", "pattern": "```[\\s\\S]{800,}" }
      ]
    },
    {
      "id": "readme-fix",
      "mode": "human-docs",
      "prompt": "README install steps are wrong after the CLI rename — fix them.",
      "minScore": 0.8,
      "required": [
        { "name": "mode or README", "pattern": "\\bMode:\\s*human-docs\\b|\\bREADME\\b|\\bDi[aá]taxis\\b" },
        { "name": "evidence", "pattern": "\\bevidence\\b|\\bverif(?:y|ied)\\b|\\bpackage\\.json\\b|\\b--help\\b" },
        { "name": "gate", "pattern": "\\boutline\\b|\\bapprov|\\bWRITE\\b|\\btarget" }
      ]
    },
    {
      "id": "adr-decision",
      "mode": "adr",
      "prompt": "Record why we chose SQLite over Redis for session state.",
      "minScore": 0.8,
      "required": [
        { "name": "adr mode", "pattern": "\\bADR\\b|\\bMode:\\s*adr\\b" },
        { "name": "decision", "pattern": "\\bDecision\\b|\\bChose\\b|\\bchosen\\b" },
        { "name": "alternatives", "pattern": "\\balternativ|\\bRedis\\b|\\bSQLite\\b|\\bdo-nothing\\b|\\bconsidered\\b" }
      ]
    },
    {
      "id": "runbook",
      "mode": "human-docs",
      "prompt": "Write a runbook for recovering when the MCP server fails to start.",
      "minScore": 0.8,
      "required": [
        { "name": "runbook or how-to", "pattern": "\\brunbook\\b|\\bMode:\\s*human-docs\\b|\\bhow.?to\\b|\\btroubleshoot" },
        { "name": "steps", "pattern": "\\bstep|\\b1\\.|\\bcheck\\b|\\brecover|\\bverify" },
        { "name": "evidence or gate", "pattern": "\\bevidence\\b|\\bverif|\\boutline\\b|\\bapprov|\\bunverified\\b" }
      ]
    },
    {
      "id": "diataxis-split",
      "mode": "human-docs",
      "prompt": "Restructure these mixed docs into Diátaxis — tutorials vs reference.",
      "minScore": 0.8,
      "required": [
        { "name": "diataxis", "pattern": "\\bDi[aá]taxis\\b|\\btutorial\\b|\\breference\\b|\\bhow.?to\\b|\\bexplanation\\b" },
        { "name": "one type", "pattern": "\\bone (?:type|page)\\b|\\blink siblings\\b|\\bdo not mix\\b|\\bseparate" },
        { "name": "gate", "pattern": "\\boutline\\b|\\bapprov|\\bWRITE\\b|\\btarget" }
      ]
    },
    {
      "id": "skill-route-away",
      "mode": "route",
      "prompt": "Create a new SKILL.md for browser debugging.",
      "minScore": 0.8,
      "required": [
        { "name": "route to skills", "pattern": "\\boctocode-skills\\b|\\bSKILL\\.md\\b" }
      ]
    }
  ]
}
