{
  "schemaVersion": 1,
  "description": "Smoke evals for octocode-subagent answers. Deterministic floor; spawn quality still needs host observation.",
  "rubric": [
    "Runs spawn gate; defaults to solo when cheap.",
    "One bounded objective per worker.",
    "Packets are sealed (goal/scope/authority/return shape).",
    "Barrier before synthesize; treats worker output as claims.",
    "Declares write ownership for parallel edits.",
    "Uses fresh-context rubber-duck / interview / mimic-flow when challenging claims."
  ],
  "cases": [
    {
      "id": "solo-first",
      "mode": "gate",
      "prompt": "Read one file and summarize it — should you spawn?",
      "minScore": 0.85,
      "required": [
        { "name": "solo decision", "pattern": "\\bsolo\\b|\\bparent\\b|\\bdo not spawn\\b|\\bno spawn\\b" },
        { "name": "spawn gate", "pattern": "\\bgate\\b|\\bearn\\b|\\bcost\\b|\\bnot worth\\b|\\bindependent\\b" }
      ],
      "forbidden": [
        { "name": "unearned fan-out", "pattern": "\\bspawn(?:ing)? (?:three|3|several|many) (?:workers|subagents)\\b" }
      ]
    },
    {
      "id": "parallel-packages",
      "mode": "spawn",
      "prompt": "Two independent packages need implementation in parallel with disjoint paths.",
      "minScore": 0.8,
      "required": [
        { "name": "spawn justified", "pattern": "\\bspawn\\b|\\bworker\\b|\\bsubagent\\b" },
        { "name": "packet", "pattern": "\\bpacket\\b|\\bgoal\\b|\\bscope\\b|\\bauthority\\b|\\breturn\\b" },
        { "name": "ownership", "pattern": "\\bownership\\b|\\bdisjoint\\b|\\bwrite path" },
        { "name": "barrier", "pattern": "\\bbarrier\\b|\\bwait\\b|\\bsynthes" }
      ]
    },
    {
      "id": "synthesize-claims",
      "mode": "synthesize",
      "prompt": "Two workers returned conflicting findings — produce the parent answer.",
      "minScore": 0.8,
      "required": [
        { "name": "claims not facts", "pattern": "\\bclaim\\b|\\bre-?check\\b|\\bconflict\\b|\\bunverified\\b" },
        { "name": "synthesize", "pattern": "\\bsynthes|\\bmerge\\b|\\breconcil" },
        { "name": "barrier or wait", "pattern": "\\bbarrier\\b|\\ball workers\\b|\\blive worker" }
      ]
    },
    {
      "id": "rubber-duck",
      "mode": "technique",
      "prompt": "Rubber-duck this migration plan before we implement — surface assumptions.",
      "minScore": 0.8,
      "required": [
        { "name": "duck or restatement", "pattern": "\\brubber.?duck\\b|\\brestat" },
        { "name": "assumptions or questions", "pattern": "\\bassumption|\\bquestions?\\b|\\bgaps?\\b" },
        { "name": "fresh or no full chat", "pattern": "\\bfresh\\b|\\bnot (?:the )?full (?:chat|transcript)\\b|\\bminimal tools\\b|\\blistener\\b" }
      ],
      "forbidden": [
        { "name": "agreement is proof", "pattern": "\\bagreement is proof\\b|\\blooks fine,? ship it\\b" }
      ]
    },
    {
      "id": "interview-claims",
      "mode": "technique",
      "prompt": "Interview the research worker’s claims before we trust the fix.",
      "minScore": 0.8,
      "required": [
        { "name": "interview", "pattern": "\\binterview\\b" },
        { "name": "fresh interviewer", "pattern": "\\bfresh\\b|\\bnot (?:the )?transcript\\b|\\banchors? only\\b|\\bsealed claim" },
        { "name": "falsify or contested", "pattern": "\\bfalsif|\\bcontested\\b|\\bcontradict|\\bclaim_table\\b|\\bre-?check\\b" }
      ]
    },
    {
      "id": "mimic-flow",
      "mode": "technique",
      "prompt": "Have a worker mimic the research claim-ledger playbook without dumping parent chat.",
      "minScore": 0.8,
      "required": [
        { "name": "mimic or playbook", "pattern": "\\bmimic\\b|\\bplaybook\\b|\\binstruction lend" },
        { "name": "filtered share", "pattern": "\\bexcerpt\\b|\\bchecklist\\b|\\bfiltered\\b|\\bno (?:full )?(?:chat|transcript)\\b" },
        { "name": "fresh evidence", "pattern": "\\bfresh evidence\\b|\\bnot conclusions\\b|\\bacceptance\\b" }
      ],
      "forbidden": [
        { "name": "dump transcript", "pattern": "\\bpaste (?:the )?full (?:parent )?transcript\\b|\\bshare (?:the )?entire chat\\b" }
      ]
    },
    {
      "id": "red-team",
      "mode": "technique",
      "prompt": "Devil’s advocate / premortem this rollout plan before we ship.",
      "minScore": 0.8,
      "required": [
        { "name": "red-team or premortem", "pattern": "\\bred.?team\\b|\\bpremortem\\b|\\bdevil.?s advocate\\b|\\bkill-?shots?\\b" },
        { "name": "attacks or failure", "pattern": "\\battack|\\bfailure\\b|\\brisk|\\bfalsif" },
        { "name": "fresh context", "pattern": "\\bfresh\\b|\\bno author\\b|\\bnot (?:the )?transcript\\b" }
      ]
    },
    {
      "id": "blind-review",
      "mode": "technique",
      "prompt": "Blind-review this PR description — judge the artifact only.",
      "minScore": 0.8,
      "required": [
        { "name": "blind", "pattern": "\\bblind\\b" },
        { "name": "artifact only", "pattern": "\\bartifact\\b|\\bacceptance\\b|\\bno author\\b|\\bno rationale\\b|\\bno transcript\\b" },
        { "name": "criteria or verdict", "pattern": "\\bcriteri|\\bpass\\b|\\bfail\\b|\\bverdict\\b" }
      ]
    },
    {
      "id": "consensus",
      "mode": "technique",
      "prompt": "Three independent workers same sealed packet — take consensus.",
      "minScore": 0.8,
      "required": [
        { "name": "consensus or majority", "pattern": "\\bconsensus\\b|\\bmajority\\b|\\bself-?consist" },
        { "name": "independent", "pattern": "\\bindependent\\b|\\bno lateral\\b|\\bsame (?:sealed )?packet\\b" },
        { "name": "anchors still", "pattern": "\\banchor|\\bre-?check\\b|\\bnot proof\\b|\\bclaim\\b" }
      ]
    }
  ]
}
