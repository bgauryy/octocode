{"results":[{"index":0,"data":{"type":"pullRequests","pullRequests":[{"number":37193,"title":"Add `onBrowserBailout` Fizz option","state":"merged","bodyPreview":"Adds a new Fizz option, `onBrowserBailout`, for observing intentional server-render bailouts caused by `ReactDOM.browser()` and future APIs that use the same recoverable error mechanism. The callback receives the original recoverable error and `ErrorInfo`, defaults to a noop, and runs only when Fizz successfully recovers by deferring work to the browser.\n\nRecoverables consumed within Suspense or used to abort recoverable boundaries are reported through `onBrowserBailout` without also invoking...","author":"gnoff","labels":["CLA Signed","React Core Team"],"targetBranch":"main","sourceBranch":"jstory/on-browser-bailout","sourceSha":"dde3dade9a955fea14462859a0cfb686ab9e767b","createdAt":"2026-08-03T19:02:44Z","updatedAt":"2026-08-08T02:31:51Z","closedAt":"2026-08-08T02:31:47Z","mergedAt":"2026-08-08T02:31:47Z","mergeCommitSha":"2042572329425f9ebf35ae6287ea5bab72b2c497","commentsCount":2,"changedFilesCount":17,"additions":130,"deletions":24,"next":{"getBody":{"tool":"ghGetHistoryItem","confidence":"exact","query":{"operation":"pullRequest","repo":"react","fileFilter":{"paths":["packages/react-dom/src/server/ReactDOMFizzServerBun.js"]},"content":{"body":true},"number":37193,"owner":"facebook","followUp":true}},"getChangedFiles":{"tool":"ghGetHistoryItem","confidence":"exact","query":{"operation":"pullRequest","repo":"react","fileFilter":{"paths":["packages/react-dom/src/server/ReactDOMFizzServerBun.js"]},"content":{"changedFiles":true},"number":37193,"owner":"facebook","followUp":true}},"getAllPatches":{"tool":"ghGetHistoryItem","confidence":"exact","query":{"operation":"pullRequest","repo":"react","fileFilter":{"paths":["packages/react-dom/src/server/ReactDOMFizzServerBun.js"]},"content":{"patches":{"mode":"all"}},"number":37193,"owner":"facebook","followUp":true}},"getComments":{"tool":"ghGetHistoryItem","co