{"results":[{"index":0,"data":{"type":"pullRequests","pullRequests":[{"number":37193,"title":"Add `onBrowserBailout` Fizz option","state":"merged","author":"gnoff","labels":["CLA Signed","React Core Team"],"targetBranch":"main","sourceBranch":"jstory/on-browser-bailout","sourceSha":"dde3dade9a955fea14462859a0cfb686ab9e767b","createdAt":"2026-08-03T19:02:44Z","updatedAt":"2026-08-08T02:31:51Z","closedAt":"2026-08-08T02:31:47Z","mergedAt":"2026-08-08T02:31:47Z","mergeCommitSha":"2042572329425f9ebf35ae6287ea5bab72b2c497","commentsCount":2,"changedFilesCount":17,"additions":130,"deletions":24,"bodyPreview":"Adds a new Fizz option, `onBrowserBailout`, for observing intentional server-render bailouts caused by `ReactDOM.browser()` and future APIs that use the same recoverable error mechanism. The callback receives the original recoverable error and `ErrorInfo`, defaults to a noop, and runs only when Fizz successfully recovers by deferring work to the browser.\n\nRecoverables consumed within Suspense or used to abort recoverable boundaries are reported through `onBrowserBailout` without also invoking...","changedFiles":["M +31 -4 packages/react-dom/src/__tests__/ReactDOMFizzServer-test.js",{"packages/react-dom/src/server/":["M +4 -0 ReactDOMFizzServerBrowser.js","M +2 -0 ReactDOMFizzServerBun.js","M +4 -0 ReactDOMFizzServerEdge.js","M +6 -0 ReactDOMFizzServerNode.js","M +4 -0 ReactDOMFizzStaticBrowser.js","M +4 -0 ReactDOMFizzStaticEdge.js","M +6 -0 ReactDOMFizzStaticNode.js","M +1 -0 ReactDOMLegacyServerImpl.js"]},"M +1 -6 packages/react-dom/src/shared/ReactDOMBrowser.js",{"packages/react-markup/src/":["M +1 -0 ReactMarkupClient.js","M +1 -0 ReactMarkupServer.js"]},"M +2 -0 packages/react-noop-renderer/src/ReactNoopServer.js","M +3 -1 packages/react-server-dom-fb/src/ReactDOMServerFB.js",{"packages/react-server/src/":["M +3 -4 ReactFizzHooks.js","M +56 -8 ReactFizzServer.js"]},"M +1 -1 scripts/error-codes/codes.json"],"next":{"getBody":{"tool":"ghGetHistoryItem","confiden